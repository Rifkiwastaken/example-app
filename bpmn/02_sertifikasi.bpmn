<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="ProsesSertifikasi" name="Proses Sertifikasi Benih" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Sertifikasi" name="Mulai Proses Sertifikasi">
      <bpmn:outgoing>Flow_PilihPanen</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_PilihPanen" name="Pengguna Memilih Hasil Panen">
      <bpmn:incoming>Flow_PilihPanen</bpmn:incoming>
      <bpmn:outgoing>Flow_LoadHarvestData</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_LoadHarvestData" name="Mengambil Data Panen dari Database">
      <bpmn:incoming>Flow_LoadHarvestData</bpmn:incoming>
      <bpmn:outgoing>Flow_BuatSertifikasi</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_BuatSertifikasi" name="Membuat Sertifikasi Baru di Database">
      <bpmn:incoming>Flow_BuatSertifikasi</bpmn:incoming>
      <bpmn:outgoing>Flow_PilihKelasBenih</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_PilihKelasBenih" name="Pengguna Memilih Kelas Benih (BS/BP/BR)">
      <bpmn:incoming>Flow_PilihKelasBenih</bpmn:incoming>
      <bpmn:outgoing>Flow_BuatLaporan</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BuatLaporanPemeriksaan" name="Pengguna Membuat Laporan Pemeriksaan">
      <bpmn:incoming>Flow_BuatLaporan</bpmn:incoming>
      <bpmn:outgoing>Flow_InputDataInspeksi</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_InputDataInspeksi" name="Pengguna Mengisi Data Inspeksi">
      <bpmn:incoming>Flow_InputDataInspeksi</bpmn:incoming>
      <bpmn:outgoing>Flow_UploadDokumen</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_UploadDokumen" name="Menyimpan Dokumen Scan ke Storage">
      <bpmn:incoming>Flow_UploadDokumen</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidasiLaporan</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ValidasiLaporan" name="Memvalidasi Data Laporan">
      <bpmn:incoming>Flow_ValidasiLaporan</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckReportNumber</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckReportNumber" name="Memeriksa Nomor Laporan Unik di Database">
      <bpmn:incoming>Flow_CheckReportNumber</bpmn:incoming>
      <bpmn:outgoing>Flow_GatewayValidasi</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ValidasiLaporan" name="Laporan Valid?">
      <bpmn:incoming>Flow_GatewayValidasi</bpmn:incoming>
      <bpmn:outgoing>Flow_LaporanValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_LaporanTidakValid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SimpanLaporan" name="Menyimpan Laporan Pemeriksaan ke Database">
      <bpmn:incoming>Flow_LaporanValid</bpmn:incoming>
      <bpmn:outgoing>Flow_InsertReport</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_InsertReport" name="Menyimpan ke Tabel Certification Reports">
      <bpmn:incoming>Flow_InsertReport</bpmn:incoming>
      <bpmn:outgoing>Flow_EvaluasiHasil</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_EvaluasiHasil" name="Pengguna Mengevaluasi Hasil Pemeriksaan">
      <bpmn:incoming>Flow_EvaluasiHasil</bpmn:incoming>
      <bpmn:outgoing>Flow_GatewayKesimpulan</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Kesimpulan" name="Kesimpulan">
      <bpmn:incoming>Flow_GatewayKesimpulan</bpmn:incoming>
      <bpmn:outgoing>Flow_Lulus</bpmn:outgoing>
      <bpmn:outgoing>Flow_TidakLulus</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_UpdateStatusLulus" name="Memperbarui Status Sertifikasi Menjadi Lulus">
      <bpmn:incoming>Flow_Lulus</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateCertificationLulus</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateCertificationLulus" name="Update Status di Database: LULUS">
      <bpmn:incoming>Flow_UpdateCertificationLulus</bpmn:incoming>
      <bpmn:outgoing>Flow_TambahKeStok</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateStatusTidakLulus" name="Memperbarui Status Sertifikasi Menjadi Tidak Lulus">
      <bpmn:incoming>Flow_TidakLulus</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateCertificationTidakLulus</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateCertificationTidakLulus" name="Update Status di Database: TIDAK LULUS">
      <bpmn:incoming>Flow_UpdateCertificationTidakLulus</bpmn:incoming>
      <bpmn:outgoing>Flow_EndTidakLulus</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_TambahKeStok" name="Pengguna Menambahkan Benih ke Stok">
      <bpmn:incoming>Flow_TambahKeStok</bpmn:incoming>
      <bpmn:outgoing>Flow_InsertSeed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_InsertSeed" name="Menyimpan Data Benih ke Database">
      <bpmn:incoming>Flow_InsertSeed</bpmn:incoming>
      <bpmn:outgoing>Flow_LinkCertificationReport</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_LinkCertificationReport" name="Menghubungkan Laporan Sertifikasi dengan Stok">
      <bpmn:incoming>Flow_LinkCertificationReport</bpmn:incoming>
      <bpmn:outgoing>Flow_EndLulus</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Lulus" name="Sertifikasi Lulus - Benih Ditambahkan ke Stok">
      <bpmn:incoming>Flow_EndLulus</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_TidakLulus" name="Sertifikasi Tidak Lulus">
      <bpmn:incoming>Flow_EndTidakLulus</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_LaporanTidakValid" name="Laporan Tidak Valid">
      <bpmn:incoming>Flow_LaporanTidakValid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStore id="Database" name="Database" />
    <bpmn:dataStoreReference id="DataStore_Database" name="Database">
      <bpmn:dataStoreRef>Database</bpmn:dataStoreRef>
    </bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="Flow_PilihPanen" sourceRef="StartEvent_Sertifikasi" targetRef="Task_PilihPanen" />
    <bpmn:sequenceFlow id="Flow_LoadHarvestData" sourceRef="Task_PilihPanen" targetRef="Task_LoadHarvestData" />
    <bpmn:sequenceFlow id="Flow_BuatSertifikasi" sourceRef="Task_LoadHarvestData" targetRef="Task_BuatSertifikasi" />
    <bpmn:sequenceFlow id="Flow_PilihKelasBenih" sourceRef="Task_BuatSertifikasi" targetRef="Task_PilihKelasBenih" />
    <bpmn:sequenceFlow id="Flow_BuatLaporan" sourceRef="Task_PilihKelasBenih" targetRef="Task_BuatLaporanPemeriksaan" />
    <bpmn:sequenceFlow id="Flow_InputDataInspeksi" sourceRef="Task_BuatLaporanPemeriksaan" targetRef="Task_InputDataInspeksi" />
    <bpmn:sequenceFlow id="Flow_UploadDokumen" sourceRef="Task_InputDataInspeksi" targetRef="Task_UploadDokumen" />
    <bpmn:sequenceFlow id="Flow_ValidasiLaporan" sourceRef="Task_UploadDokumen" targetRef="Task_ValidasiLaporan" />
    <bpmn:sequenceFlow id="Flow_CheckReportNumber" sourceRef="Task_ValidasiLaporan" targetRef="Task_CheckReportNumber" />
    <bpmn:sequenceFlow id="Flow_GatewayValidasi" sourceRef="Task_CheckReportNumber" targetRef="Gateway_ValidasiLaporan" />
    <bpmn:sequenceFlow id="Flow_LaporanValid" name="Ya" sourceRef="Gateway_ValidasiLaporan" targetRef="Task_SimpanLaporan" />
    <bpmn:sequenceFlow id="Flow_LaporanTidakValid" name="Tidak" sourceRef="Gateway_ValidasiLaporan" targetRef="EndEvent_LaporanTidakValid" />
    <bpmn:sequenceFlow id="Flow_InsertReport" sourceRef="Task_SimpanLaporan" targetRef="Task_InsertReport" />
    <bpmn:sequenceFlow id="Flow_EvaluasiHasil" sourceRef="Task_InsertReport" targetRef="Task_EvaluasiHasil" />
    <bpmn:sequenceFlow id="Flow_GatewayKesimpulan" sourceRef="Task_EvaluasiHasil" targetRef="Gateway_Kesimpulan" />
    <bpmn:sequenceFlow id="Flow_Lulus" name="LULUS" sourceRef="Gateway_Kesimpulan" targetRef="Task_UpdateStatusLulus" />
    <bpmn:sequenceFlow id="Flow_TidakLulus" name="TIDAK LULUS" sourceRef="Gateway_Kesimpulan" targetRef="Task_UpdateStatusTidakLulus" />
    <bpmn:sequenceFlow id="Flow_UpdateCertificationLulus" sourceRef="Task_UpdateStatusLulus" targetRef="Task_UpdateCertificationLulus" />
    <bpmn:sequenceFlow id="Flow_UpdateCertificationTidakLulus" sourceRef="Task_UpdateStatusTidakLulus" targetRef="Task_UpdateCertificationTidakLulus" />
    <bpmn:sequenceFlow id="Flow_TambahKeStok" sourceRef="Task_UpdateCertificationLulus" targetRef="Task_TambahKeStok" />
    <bpmn:sequenceFlow id="Flow_InsertSeed" sourceRef="Task_TambahKeStok" targetRef="Task_InsertSeed" />
    <bpmn:sequenceFlow id="Flow_LinkCertificationReport" sourceRef="Task_InsertSeed" targetRef="Task_LinkCertificationReport" />
    <bpmn:sequenceFlow id="Flow_EndLulus" sourceRef="Task_LinkCertificationReport" targetRef="EndEvent_Lulus" />
    <bpmn:sequenceFlow id="Flow_EndTidakLulus" sourceRef="Task_UpdateCertificationTidakLulus" targetRef="EndEvent_TidakLulus" />
    <bpmn:association id="Association_LoadHarvest" sourceRef="Task_LoadHarvestData" targetRef="DataStore_Database" />
    <bpmn:association id="Association_CreateCertification" sourceRef="Task_BuatSertifikasi" targetRef="DataStore_Database" />
    <bpmn:association id="Association_CheckReportNumber" sourceRef="Task_CheckReportNumber" targetRef="DataStore_Database" />
    <bpmn:association id="Association_InsertReport" sourceRef="Task_InsertReport" targetRef="DataStore_Database" />
    <bpmn:association id="Association_UpdateLulus" sourceRef="Task_UpdateCertificationLulus" targetRef="DataStore_Database" />
    <bpmn:association id="Association_UpdateTidakLulus" sourceRef="Task_UpdateCertificationTidakLulus" targetRef="DataStore_Database" />
    <bpmn:association id="Association_InsertSeed" sourceRef="Task_InsertSeed" targetRef="DataStore_Database" />
    <bpmn:association id="Association_LinkReport" sourceRef="Task_LinkCertificationReport" targetRef="DataStore_Database" />
  </bpmn:process>
