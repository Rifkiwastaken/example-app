@startuml
' Referensi: Use Case Overview (00_use_case_overview.puml)
' Use case 10: Logout
' Aktor: Admin/Kepala Sek, Petugas BBI, Penangkar/Kepala Satgas, Petugas Gudang
!theme plain
skinparam backgroundColor white
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam swimlane {
    BackgroundColor White
    BorderColor #CCCCCC
    TitleBackgroundColor White
    TitleBorderColor #999999
}

title Activity Diagram - Logout

|#White|User|
start
:Klik tombol logout;

|#White|Sistem|
:Validasi session;
:Hapus session;
:Hapus cookies;
:Redirect ke halaman login;

|#White|User|
:Masuk ke halaman login;

stop

@enduml
