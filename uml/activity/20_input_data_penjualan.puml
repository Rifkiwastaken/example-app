@startuml
!theme plain
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam swimlane {
    BackgroundColor #F5F5F5
    BorderColor #424242
    TitleBackgroundColor #BBDEFB
    TitleBorderColor #1976D2
}

title Activity Diagram - Input Data Penjualan

|#LightBlue|Petugas BBI|
start
:Masuk ke form input penjualan;

|#LightGreen|Sistem|
:Validasi role pengguna;
:Query data stok tersedia;
:Query data gudang dan bin;
:Query data inventory types;
:Menampilkan form input penjualan;

|#LightBlue|Petugas BBI|
:Input data pelanggan\n(nama, kontak, alamat);
:Pilih list untuk dijual;
:Input item penjualan\n(inventory_type, quantity, unit_price);
:Tambah item penjualan (jika banyak);
:Submit form;

|#LightGreen|Sistem|
:Validasi data penjualan;
:Check stok tersedia untuk setiap item;
:Check kapasitas gudang;

if (Stok cukup?) then (Ya)
    :Proses penjualan;
    :Insert ke tabel sales;
    :Insert ke tabel sale_items;
    :Update stok menggunakan FIFO;
    :Create transaction record;
    :Generate nomor nota;
    :Success message;
    :Redirect ke halaman detail penjualan;
    |#LightBlue|Petugas BBI|
    :Lihat pesan penjualan berhasil dibuat;
else (Tidak)
    :Error: stok tidak cukup;
    :Tampilkan item yang bermasalah;
    :Kembali ke form;
    |#LightBlue|Petugas BBI|
    :Lihat form dengan pesan error;
endif

stop

@enduml
