@startuml Activity Diagram - Modul Manajemen User
!theme plain
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam swimlane {
    BackgroundColor #F5F5F5
    BorderColor #424242
    TitleBackgroundColor #BBDEFB
    TitleBorderColor #1976D2
}

title Activity Diagram - Modul Manajemen User

' ============================================
' Use Case: Kelola User
' ============================================
|#LightBlue|Admin|
start
:Masuk ke halaman kelola user;

|#LightGreen|Sistem|
:Validasi role admin;
:Query data user dari database;
:Display daftar user;

|#LightBlue|Admin|
if (Aksi?) then (Tambah User)
    :Masuk ke form tambah user;
    :Input data user\n(nama, email, password);
    :Pilih role;
    :Input data tambahan\n(lokasi, kontak);
    :Submit form;
    
    |#LightGreen|Sistem|
    :Validasi data user;
    :Check email unik;
    :Hash password;
    :Insert ke tabel users;
    :Success message;
else (Edit User)
    :Pilih user;
    :Edit data user;
    :Submit form;
    
    |#LightGreen|Sistem|
    :Validasi data user;
    :Update data di tabel users;
    :Update password (jika diubah);
    :Success message;
else (Hapus User)
    :Pilih user;
    :Konfirmasi penghapusan;
    
    |#LightGreen|Sistem|
    :Check relasi user dengan data lain;
    if (Dapat dihapus?) then (Ya)
        :Delete dari tabel users;
        :Success message;
    else (Tidak)
        :Error: user memiliki relasi data;
    endif
else (Lihat Detail User)
    :Pilih user;
    
    |#LightGreen|Sistem|
    :Load data user lengkap;
    :Load data relasi;
    :Display detail user;
endif

stop

' ============================================
' Use Case: Kelola Role
' ============================================
|#LightBlue|Admin|
start
:Masuk ke halaman kelola role;

|#LightGreen|Sistem|
:Validasi role admin;
:Query data role dari sistem;
:Display daftar role dan permission;

|#LightBlue|Admin|
:Lihat daftar role;
:Lihat permission setiap role;
:Edit permission role (jika perlu);

|#LightGreen|Sistem|
:Update permission role;
:Simpan perubahan;
:Success message;

stop

@enduml













