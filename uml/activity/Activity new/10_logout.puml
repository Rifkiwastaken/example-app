@startuml
' Referensi: Use Case Overview (00_use_case_overview.puml)
' Use case 10: Logout
' Aktor: Admin/Kepala Sek, Petugas BBI, Penangkar/Kepala Satgas, Petugas Gudang
!theme plain
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam swimlane {
    BackgroundColor #F5F5F5
    BorderColor #424242
    TitleBackgroundColor #BBDEFB
    TitleBorderColor #1976D2
}

title Activity Diagram - Logout

|#LightBlue|User|
start
:Klik tombol logout;

|#LightGreen|Sistem|
:Validasi session;
:Hapus session;
:Hapus cookies;
:Redirect ke halaman login;

|#LightBlue|User|
:Masuk ke halaman login;

stop

@enduml
