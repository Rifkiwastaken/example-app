<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Penjualan_Clean" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Penjualan" name="Proses Penjualan" isExecutable="true">
    <bpmn:startEvent id="Start_Penjualan" name="Mulai" />
    <bpmn:userTask id="User_InputPenjualan" name="Input Data Penjualan" />
    <bpmn:serviceTask id="Srv_ValidasiPenjualan" name="Validasi Penjualan" />
    <bpmn:exclusiveGateway id="Gw_StokCukup" name="Stok Cukup?" />
    <bpmn:userTask id="User_InputItem" name="Input Item & Harga" />
    <bpmn:exclusiveGateway id="Gw_ItemLain" name="Ada Item Lain?" />
    <bpmn:serviceTask id="Srv_ProsesFIFO" name="Kurangi Stok (FIFO)" />
    <bpmn:serviceTask id="Srv_SimpanPenjualan" name="Simpan Penjualan & Item" />
    <bpmn:endEvent id="End_Penjualan" name="Selesai" />

    <bpmn:sequenceFlow id="PFlow_1" sourceRef="Start_Penjualan" targetRef="User_InputPenjualan" />
    <bpmn:sequenceFlow id="PFlow_2" sourceRef="User_InputPenjualan" targetRef="Srv_ValidasiPenjualan" />
    <bpmn:sequenceFlow id="PFlow_3" sourceRef="Srv_ValidasiPenjualan" targetRef="Gw_StokCukup" />
    <bpmn:sequenceFlow id="PFlow_4" sourceRef="Gw_StokCukup" targetRef="User_InputItem">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[cukup]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PFlow_5" sourceRef="Gw_StokCukup" targetRef="User_InputPenjualan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[!cukup]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PFlow_6" sourceRef="User_InputItem" targetRef="Gw_ItemLain" />
    <bpmn:sequenceFlow id="PFlow_7" sourceRef="Gw_ItemLain" targetRef="Srv_ProsesFIFO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[tidak]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PFlow_8" sourceRef="Gw_ItemLain" targetRef="User_InputItem">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[ya]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PFlow_9" sourceRef="Srv_ProsesFIFO" targetRef="Srv_SimpanPenjualan" />
    <bpmn:sequenceFlow id="PFlow_10" sourceRef="Srv_SimpanPenjualan" targetRef="End_Penjualan" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diag_Penjualan_Clean">
    <bpmndi:BPMNPlane id="Plane_Penjualan_Clean" bpmnElement="Process_Penjualan">
      <bpmndi:BPMNShape id="DI_Start_Penjualan" bpmnElement="Start_Penjualan">
        <omgdc:Bounds x="120" y="150" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_User_InputPenjualan" bpmnElement="User_InputPenjualan">
        <omgdc:Bounds x="190" y="130" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Srv_ValidasiPenjualan" bpmnElement="Srv_ValidasiPenjualan">
        <omgdc:Bounds x="380" y="130" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Gw_StokCukup" bpmnElement="Gw_StokCukup" isMarkerVisible="true">
        <omgdc:Bounds x="570" y="145" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_User_InputItem" bpmnElement="User_InputItem">
        <omgdc:Bounds x="690" y="130" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Gw_ItemLain" bpmnElement="Gw_ItemLain" isMarkerVisible="true">
        <omgdc:Bounds x="880" y="145" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Srv_ProsesFIFO" bpmnElement="Srv_ProsesFIFO">
        <omgdc:Bounds x="1020" y="130" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Srv_SimpanPenjualan" bpmnElement="Srv_SimpanPenjualan">
        <omgdc:Bounds x="1240" y="130" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_Penjualan" bpmnElement="End_Penjualan">
        <omgdc:Bounds x="1450" y="150" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="DI_PFlow_1" bpmnElement="PFlow_1">
        <omgdi:waypoint x="156" y="168" />
        <omgdi:waypoint x="190" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PFlow_2" bpmnElement="PFlow_2">
        <omgdi:waypoint x="350" y="168" />
        <omgdi:waypoint x="380" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PFlow_3" bpmnElement="PFlow_3">
        <omgdi:waypoint x="540" y="168" />
        <omgdi:waypoint x="570" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PFlow_4" bpmnElement="PFlow_4">
        <omgdi:waypoint x="620" y="168" />
        <omgdi:waypoint x="690" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PFlow_5" bpmnElement="PFlow_5">
        <omgdi:waypoint x="595" y="195" />
        <omgdi:waypoint x="595" y="240" />
        <omgdi:waypoint x="270" y="240" />
        <omgdi:waypoint x="270" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PFlow_6" bpmnElement="PFlow_6">
        <omgdi:waypoint x="850" y="168" />
        <omgdi:waypoint x="880" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PFlow_7" bpmnElement="PFlow_7">
        <omgdi:waypoint x="930" y="168" />
        <omgdi:waypoint x="1020" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PFlow_8" bpmnElement="PFlow_8">
        <omgdi:waypoint x="905" y="195" />
        <omgdi:waypoint x="905" y="230" />
        <omgdi:waypoint x="770" y="230" />
        <omgdi:waypoint x="770" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PFlow_9" bpmnElement="PFlow_9">
        <omgdi:waypoint x="1200" y="168" />
        <omgdi:waypoint x="1240" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PFlow_10" bpmnElement="PFlow_10">
        <omgdi:waypoint x="1420" y="168" />
        <omgdi:waypoint x="1450" y="168" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
















