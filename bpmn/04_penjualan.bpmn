<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_4" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="ProsesPenjualan" name="Proses Penjualan Benih" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Penjualan" name="Mulai Proses Penjualan">
      <bpmn:outgoing>Flow_InputDataPenjualan</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_InputDataPenjualan" name="Pengguna Mengisi Data Penjualan">
      <bpmn:incoming>Flow_InputDataPenjualan</bpmn:incoming>
      <bpmn:outgoing>Flow_PilihGudang</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PilihGudang" name="Pengguna Memilih Gudang dan Bin">
      <bpmn:incoming>Flow_PilihGudang</bpmn:incoming>
      <bpmn:outgoing>Flow_PilihLot</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PilihLot" name="Pengguna Memilih Lot yang Akan Dijual">
      <bpmn:incoming>Flow_PilihLot</bpmn:incoming>
      <bpmn:outgoing>Flow_InputQuantity</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_InputQuantity" name="Pengguna Mengisi Jumlah dan Harga">
      <bpmn:incoming>Flow_InputQuantity</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidasiPenjualan</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidasiPenjualan" name="Memvalidasi Data Penjualan">
      <bpmn:incoming>Flow_ValidasiPenjualan</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckReceiptNumber</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckReceiptNumber" name="Memeriksa Nomor Nota Unik di Database">
      <bpmn:incoming>Flow_CheckReceiptNumber</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckStokPenjualan</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckStokPenjualan" name="Memeriksa Stok Tersedia di Database">
      <bpmn:incoming>Flow_CheckStokPenjualan</bpmn:incoming>
      <bpmn:outgoing>Flow_GatewayValidasiStok</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ValidasiStok" name="Stok Cukup?">
      <bpmn:incoming>Flow_GatewayValidasiStok</bpmn:incoming>
      <bpmn:outgoing>Flow_StokCukup</bpmn:outgoing>
      <bpmn:outgoing>Flow_StokTidakCukup</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SimpanPenjualan" name="Menyimpan Data Penjualan ke Database">
      <bpmn:incoming>Flow_StokCukup</bpmn:incoming>
      <bpmn:outgoing>Flow_InsertSale</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_InsertSale" name="Menyimpan ke Tabel Sales">
      <bpmn:incoming>Flow_InsertSale</bpmn:incoming>
      <bpmn:outgoing>Flow_SimpanItem</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SimpanItem" name="Menyimpan Item Penjualan ke Database">
      <bpmn:incoming>Flow_SimpanItem</bpmn:incoming>
      <bpmn:outgoing>Flow_InsertSaleItem</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_InsertSaleItem" name="Menyimpan ke Tabel Sale Items">
      <bpmn:incoming>Flow_InsertSaleItem</bpmn:incoming>
      <bpmn:outgoing>Flow_KurangiStok</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_KurangiStok" name="Mengurangi Stok dari Lot (FIFO)">
      <bpmn:incoming>Flow_KurangiStok</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateInventoryLot</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateInventoryLot" name="Memperbarui Stok di Tabel Inventory Lots">
      <bpmn:incoming>Flow_UpdateInventoryLot</bpmn:incoming>
      <bpmn:outgoing>Flow_CatatTransaksi</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CatatTransaksi" name="Mencatat Transaksi Penjualan">
      <bpmn:incoming>Flow_CatatTransaksi</bpmn:incoming>
      <bpmn:outgoing>Flow_InsertTransaction</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_InsertTransaction" name="Menyimpan ke Tabel Inventory Transactions">
      <bpmn:incoming>Flow_InsertTransaction</bpmn:incoming>
      <bpmn:outgoing>Flow_EndPenjualan</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Penjualan" name="Penjualan Berhasil">
      <bpmn:incoming>Flow_EndPenjualan</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_StokTidakCukup" name="Stok Tidak Cukup">
      <bpmn:incoming>Flow_StokTidakCukup</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStore id="Database" name="Database" />
    <bpmn:dataStoreReference id="DataStore_Database" name="Database">
      <bpmn:dataStoreRef>Database</bpmn:dataStoreRef>
    </bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="Flow_InputDataPenjualan" sourceRef="StartEvent_Penjualan" targetRef="Task_InputDataPenjualan" />
    <bpmn:sequenceFlow id="Flow_PilihGudang" sourceRef="Task_InputDataPenjualan" targetRef="Task_PilihGudang" />
    <bpmn:sequenceFlow id="Flow_PilihLot" sourceRef="Task_PilihGudang" targetRef="Task_PilihLot" />
    <bpmn:sequenceFlow id="Flow_InputQuantity" sourceRef="Task_PilihLot" targetRef="Task_InputQuantity" />
    <bpmn:sequenceFlow id="Flow_ValidasiPenjualan" sourceRef="Task_InputQuantity" targetRef="Task_ValidasiPenjualan" />
    <bpmn:sequenceFlow id="Flow_CheckReceiptNumber" sourceRef="Task_ValidasiPenjualan" targetRef="Task_CheckReceiptNumber" />
    <bpmn:sequenceFlow id="Flow_CheckStokPenjualan" sourceRef="Task_CheckReceiptNumber" targetRef="Task_CheckStokPenjualan" />
    <bpmn:sequenceFlow id="Flow_GatewayValidasiStok" sourceRef="Task_CheckStokPenjualan" targetRef="Gateway_ValidasiStok" />
    <bpmn:sequenceFlow id="Flow_StokCukup" name="Ya" sourceRef="Gateway_ValidasiStok" targetRef="Task_SimpanPenjualan" />
    <bpmn:sequenceFlow id="Flow_StokTidakCukup" name="Tidak" sourceRef="Gateway_ValidasiStok" targetRef="EndEvent_StokTidakCukup" />
    <bpmn:sequenceFlow id="Flow_InsertSale" sourceRef="Task_SimpanPenjualan" targetRef="Task_InsertSale" />
    <bpmn:sequenceFlow id="Flow_SimpanItem" sourceRef="Task_InsertSale" targetRef="Task_SimpanItem" />
    <bpmn:sequenceFlow id="Flow_InsertSaleItem" sourceRef="Task_SimpanItem" targetRef="Task_InsertSaleItem" />
    <bpmn:sequenceFlow id="Flow_KurangiStok" sourceRef="Task_InsertSaleItem" targetRef="Task_KurangiStok" />
    <bpmn:sequenceFlow id="Flow_UpdateInventoryLot" sourceRef="Task_KurangiStok" targetRef="Task_UpdateInventoryLot" />
    <bpmn:sequenceFlow id="Flow_CatatTransaksi" sourceRef="Task_UpdateInventoryLot" targetRef="Task_CatatTransaksi" />
    <bpmn:sequenceFlow id="Flow_InsertTransaction" sourceRef="Task_CatatTransaksi" targetRef="Task_InsertTransaction" />
    <bpmn:sequenceFlow id="Flow_EndPenjualan" sourceRef="Task_InsertTransaction" targetRef="EndEvent_Penjualan" />
    <bpmn:association id="Association_CheckReceiptNumber" sourceRef="Task_CheckReceiptNumber" targetRef="DataStore_Database" />
    <bpmn:association id="Association_CheckStokPenjualan" sourceRef="Task_CheckStokPenjualan" targetRef="DataStore_Database" />
    <bpmn:association id="Association_InsertSale" sourceRef="Task_InsertSale" targetRef="DataStore_Database" />
    <bpmn:association id="Association_InsertSaleItem" sourceRef="Task_InsertSaleItem" targetRef="DataStore_Database" />
    <bpmn:association id="Association_UpdateInventoryLot" sourceRef="Task_UpdateInventoryLot" targetRef="DataStore_Database" />
    <bpmn:association id="Association_InsertTransaction" sourceRef="Task_InsertTransaction" targetRef="DataStore_Database" />
  </bpmn:process>
