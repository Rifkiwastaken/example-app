<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Penanaman_Clean" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Penanaman" name="Proses Penanaman" isExecutable="true">
    <bpmn:startEvent id="Start_Penanaman" name="Mulai" />
    <bpmn:userTask id="User_InputPenanaman" name="Isi Data Penanaman" />
    <bpmn:serviceTask id="Srv_ValidasiData" name="Validasi Data" />
    <bpmn:exclusiveGateway id="Gw_DataValid" name="Data Valid?" />
    <bpmn:serviceTask id="Srv_SimpanPenanaman" name="Simpan Penanaman" />
    <bpmn:userTask id="User_Tracking" name="Tracking Perkembangan" />
    <bpmn:exclusiveGateway id="Gw_SiapPanen" name="Siap Panen?" />
    <bpmn:userTask id="User_InputPanen" name="Isi Data Panen" />
    <bpmn:serviceTask id="Srv_SimpanPanen" name="Simpan Panen" />
    <bpmn:endEvent id="End_Penanaman" name="Selesai" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Penanaman" targetRef="User_InputPenanaman" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="User_InputPenanaman" targetRef="Srv_ValidasiData" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Srv_ValidasiData" targetRef="Gw_DataValid" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gw_DataValid" targetRef="Srv_SimpanPenanaman">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[valid]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gw_DataValid" targetRef="User_InputPenanaman">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[!valid]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Srv_SimpanPenanaman" targetRef="User_Tracking" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="User_Tracking" targetRef="Gw_SiapPanen" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gw_SiapPanen" targetRef="User_InputPanen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[siap]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gw_SiapPanen" targetRef="User_Tracking">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[!siap]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="User_InputPanen" targetRef="Srv_SimpanPanen" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Srv_SimpanPanen" targetRef="End_Penanaman" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diag_Penanaman_Clean">
    <bpmndi:BPMNPlane id="Plane_Penanaman_Clean" bpmnElement="Process_Penanaman">
      <bpmndi:BPMNShape id="DI_Start_Penanaman" bpmnElement="Start_Penanaman">
        <omgdc:Bounds x="120" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_User_InputPenanaman" bpmnElement="User_InputPenanaman">
        <omgdc:Bounds x="200" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Srv_ValidasiData" bpmnElement="Srv_ValidasiData">
        <omgdc:Bounds x="360" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Gw_DataValid" bpmnElement="Gw_DataValid" isMarkerVisible="true">
        <omgdc:Bounds x="520" y="115" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Srv_SimpanPenanaman" bpmnElement="Srv_SimpanPenanaman">
        <omgdc:Bounds x="640" y="100" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_User_Tracking" bpmnElement="User_Tracking">
        <omgdc:Bounds x="820" y="100" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Gw_SiapPanen" bpmnElement="Gw_SiapPanen" isMarkerVisible="true">
        <omgdc:Bounds x="1000" y="115" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_User_InputPanen" bpmnElement="User_InputPanen">
        <omgdc:Bounds x="1120" y="100" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Srv_SimpanPanen" bpmnElement="Srv_SimpanPanen">
        <omgdc:Bounds x="1300" y="100" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_Penanaman" bpmnElement="End_Penanaman">
        <omgdc:Bounds x="1480" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="DI_Flow_1" bpmnElement="Flow_1">
        <omgdi:waypoint x="156" y="138" />
        <omgdi:waypoint x="200" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_2" bpmnElement="Flow_2">
        <omgdi:waypoint x="320" y="138" />
        <omgdi:waypoint x="360" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_3" bpmnElement="Flow_3">
        <omgdi:waypoint x="480" y="138" />
        <omgdi:waypoint x="520" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_4" bpmnElement="Flow_4">
        <omgdi:waypoint x="570" y="138" />
        <omgdi:waypoint x="640" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_5" bpmnElement="Flow_5">
        <omgdi:waypoint x="545" y="165" />
        <omgdi:waypoint x="545" y="210" />
        <omgdi:waypoint x="260" y="210" />
        <omgdi:waypoint x="260" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_6" bpmnElement="Flow_6">
        <omgdi:waypoint x="780" y="138" />
        <omgdi:waypoint x="820" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_7" bpmnElement="Flow_7">
        <omgdi:waypoint x="960" y="138" />
        <omgdi:waypoint x="1000" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_8" bpmnElement="Flow_8">
        <omgdi:waypoint x="1050" y="138" />
        <omgdi:waypoint x="1120" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_9" bpmnElement="Flow_9">
        <omgdi:waypoint x="1025" y="165" />
        <omgdi:waypoint x="1025" y="210" />
        <omgdi:waypoint x="890" y="210" />
        <omgdi:waypoint x="890" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_10" bpmnElement="Flow_10">
        <omgdi:waypoint x="1260" y="138" />
        <omgdi:waypoint x="1300" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_11" bpmnElement="Flow_11">
        <omgdi:waypoint x="1440" y="138" />
        <omgdi:waypoint x="1480" y="138" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
















