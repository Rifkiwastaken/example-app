@startuml ERD - Database SIBESTI
!theme plain
skinparam linetype ortho
skinparam packageStyle rectangle

title SIBESTI - Entity Relationship Diagram
' Sistem Informasi Benih Sertifikasi
' Semua ID menggunakan VARCHAR(36) dengan format {nama_tabel}_id
' Tanggal Update: Februari 2026

' ============================================
' ENTITY: users
' ============================================
entity "users" as users {
    * **user_id** : VARCHAR(36) <<PK>>
    --
    name : VARCHAR(255)
    email : VARCHAR(255) <<UNIQUE>>
    email_verified_at : TIMESTAMP
    password : VARCHAR(255)
    remember_token : VARCHAR(100)
    role : ENUM('admin','pimpinan','petugas_lapangan','penangkar')
    location_id : VARCHAR(36) <<FK>>
    location_placement : VARCHAR(255)
    photo_path : VARCHAR(255)
    full_name : VARCHAR(255)
    status : ENUM('active','inactive')
    contact_type : ENUM('internal','external')
    organization : VARCHAR(255)
    position : VARCHAR(255)
    nip : VARCHAR(50)
    primary_phone : VARCHAR(20)
    secondary_phone : VARCHAR(20)
    address : TEXT
    province : VARCHAR(100)
    city : VARCHAR(100)
    district : VARCHAR(100)
    village : VARCHAR(100)
    notes : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

' ============================================
' ENTITY: locations
' ============================================
entity "locations" as locations {
    * **location_id** : VARCHAR(36) <<PK>>
    --
    name : VARCHAR(255)
    city : VARCHAR(255)
    district : VARCHAR(255)
    type : ENUM('kantor','lapangan','gudang','lainnya')
    description : TEXT
    google_maps_link : VARCHAR(500)
    photo : VARCHAR(255)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

' ============================================
' ENTITY: plant_types
' ============================================
entity "plant_types" as plant_types {
    * **plant_type_id** : VARCHAR(36) <<PK>>
    --
    name : VARCHAR(255)
    category : VARCHAR(255)
    variety : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

' ============================================
' ENTITY: plants
' ============================================
entity "plants" as plants {
    * **plant_id** : VARCHAR(36) <<PK>>
    --
    name : VARCHAR(255)
    plant_type_id : VARCHAR(36) <<FK>>
    variety : VARCHAR(255)
    status : ENUM('perencanaan','aktif','panen','selesai')
    progress : INT
    planting_location_id : VARCHAR(36) <<FK>>
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

' ============================================
' ENTITY: planting_locations
' ============================================
entity "planting_locations" as planting_locations {
    * **planting_location_id** : VARCHAR(36) <<PK>>
    --
    name : VARCHAR(255)
    location_id : VARCHAR(36) <<FK>>
    location_type : ENUM('sawah','kebun','greenhouse','polybag','lainnya')
    planting_format : ENUM('bedengan','baris','kotak','acak','lainnya')
    planting_format_custom : VARCHAR(255)
    num_beds : INT
    bed_length_m : DECIMAL(10,2)
    bed_width_m : DECIMAL(10,2)
    map_size : DECIMAL(10,2)
    light_condition : VARCHAR(255)
    description : TEXT
    location_summary : TEXT
    administrative_address : TEXT
    google_maps_link : VARCHAR(500)
    land_status : VARCHAR(255)
    ownership_status : VARCHAR(255)
    water_source : VARCHAR(255)
    soil_type : VARCHAR(255)
    elevation_masl : INT
    primary_photo_path : VARCHAR(255)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

' ============================================
' ENTITY: plantings
' ============================================
entity "plantings" as plantings {
    * **planting_id** : VARCHAR(36) <<PK>>
    --
    plant_id : VARCHAR(36) <<FK>>
    planting_location_id : VARCHAR(36) <<FK>>
