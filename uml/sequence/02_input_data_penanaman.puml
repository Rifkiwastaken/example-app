@startuml
!theme plain
skinparam sequenceMessageAlign center
skinparam roundcorner 20
skinparam maxmessagesize 60

' sd Input Data Penanaman

actor "Kepala Satgas/Penangkar" as User
participant "PlantingController" as Controller
participant "Planting" as Planting
participant "Plant" as Plant
participant "PlantingLocation" as PlantingLocation
participant "Database" as DB

User -> User: akses halaman input penanaman()
User -> Controller: create()
activate Controller
Controller -> Controller: validateRole()
Controller -> Plant: Plant::orderBy('name')->get()
activate Plant
Plant -> DB: SELECT * FROM plants ORDER BY name
DB --> Plant: return plants[]
Plant --> Controller: return plants[]
deactivate Plant

Controller -> PlantingLocation: PlantingLocation::orderBy('name')->get()
activate PlantingLocation
PlantingLocation -> DB: SELECT * FROM planting_locations ORDER BY name
DB --> PlantingLocation: return locations[]
PlantingLocation --> Controller: return locations[]
deactivate PlantingLocation

Controller --> User: return view create dengan data()
deactivate Controller
User -> User: tampilkan form input penanaman()

User -> User: isi data penanaman()
User -> Controller: store(Request)
activate Controller
Controller -> Controller: validate(Request)
Controller -> Plant: Plant::findOrFail(plant_id)
activate Plant
Plant -> DB: SELECT * FROM plants WHERE id = ?
DB --> Plant: return plant data
Plant --> Controller: return Plant
deactivate Plant

Controller -> PlantingLocation: PlantingLocation::findOrFail(planting_location_id)
activate PlantingLocation
PlantingLocation -> DB: SELECT * FROM planting_locations WHERE id = ?
DB --> PlantingLocation: return location data
PlantingLocation --> Controller: return PlantingLocation
deactivate PlantingLocation

alt Data Valid
    Controller -> Planting: Planting::create(data)
    activate Planting
    Planting -> DB: INSERT INTO plantings VALUES
    DB --> Planting: return planting_id
    Planting --> Controller: return Planting
    deactivate Planting
    
    Controller --> User: redirect back dengan success message()
    User -> User: tampilkan pesan penanaman berhasil ditambahkan()
else Data Tidak Valid
    Controller --> User: redirect back dengan validation errors()
    User -> User: tampilkan form dengan pesan error()
end
deactivate Controller

@enduml

