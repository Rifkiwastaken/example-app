@startuml
' Referensi: Use Case Overview (00_use_case_overview.puml)
' Use case 13: Mengakses Dashboard
' Aktor: Admin/Kepala Sek, Petugas BBI, Penangkar/Kepala Satgas, Petugas Gudang
!theme plain
skinparam backgroundColor white
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam swimlane {
    BackgroundColor White
    BorderColor #CCCCCC
    TitleBackgroundColor White
    TitleBorderColor #999999
}

title Activity Diagram - Mengakses Dashboard

|#White|User|
start
:Masuk ke halaman dashboard;

|#White|Sistem|
:Validasi role pengguna;
:Load data statistik berdasarkan role;

if (Role pengguna?) then (Admin)
    |#White|Sistem|
    :Load grafik tren produksi (12 bulan terakhir);
    :Load pie chart komposisi stok;
    :Load grafik tren pendapatan (12 bulan terakhir);
    :Load data tabel produksi, stok, dan pendapatan;
    :Load data cuaca;
elseif (Admin/Kepala Satgas/Penangkar) then
    |#White|Sistem|
    :Load statistik tugas (upcoming tasks);
    :Load notifikasi tugas;
    :Load notifikasi catatan;
else (Semua User)
    |#White|Sistem|
    :Load notifikasi benih yang mendekati kadaluarsa;
end

if (Role Admin atau Petugas Gudang?) then (Ya)
    |#White|Sistem|
    :Load notifikasi benih di bin yang kadaluarsa;
    :Load notifikasi stok benih rendah;
end

if (Role Admin?) then (Ya)
    |#White|Sistem|
    :Load notifikasi sertifikasi yang melewati masa edar;
end

|#White|Sistem|
:Menampilkan dashboard dengan semua data yang relevan;

|#White|User|
:Lihat dashboard dengan statistik dan grafik;
:Lihat notifikasi yang relevan;

if (Ada filter?) then (Ya)
    |#White|User|
    :Pilih filter (tanaman, tipe inventory);
    :Submit filter;
    |#White|Sistem|
    :Update data berdasarkan filter;
    :Menampilkan dashboard dengan data terfilter;
    |#White|User|
    :Lihat dashboard dengan data terfilter;
endif

stop

@enduml
