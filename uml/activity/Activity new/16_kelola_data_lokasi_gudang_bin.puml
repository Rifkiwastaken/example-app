@startuml
' Referensi: Use Case Overview (00_use_case_overview.puml)
' Use case 16: Mengelola data lokasi gudang dan bin
' Aktor: Admin/Kepala Sek, Petugas BBI, Petugas Gudang
!theme plain
skinparam backgroundColor white
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam swimlane {
    BackgroundColor White
    BorderColor #CCCCCC
    TitleBackgroundColor White
    TitleBorderColor #999999
}

title Activity Diagram - Mengelola data lokasi gudang dan bin

|#White|User|
start
:Masuk ke halaman kelola gudang;

|#White|Sistem|
:Validasi role pengguna;
:Query data gudang dari database;
:Load data bin terkait;
:Menampilkan daftar gudang;

|#White|User|
:Lihat daftar gudang;

if (Pilih aksi?) then (Kelola Gudang)
    if (Tambah Gudang) then
        |#White|User|
        :Klik tombol tambah gudang;
        |#White|Sistem|
        :Tampilkan form tambah gudang;
        |#White|User|
        :Isi form data gudang;
        :Submit form;
        |#White|Sistem|
        :Validasi data;
        if (Data valid?) then (Ya)
            :Simpan data gudang ke database;
            :Tampilkan pesan sukses;
        else (Tidak)
            :Tampilkan pesan error;
        endif
    elseif (Edit Gudang) then
        |#White|User|
        :Klik tombol edit gudang;
        |#White|Sistem|
        :Tampilkan form edit dengan data terisi;
        |#White|User|
        :Edit data gudang;
        :Submit form;
        |#White|Sistem|
        :Validasi data;
        if (Data valid?) then (Ya)
            :Update data gudang di database;
            :Tampilkan pesan sukses;
        else (Tidak)
            :Tampilkan pesan error;
        endif
    elseif (Kelola Bin) then
        |#White|User|
        :Klik tombol kelola bin;
        |#White|Sistem|
        :Tampilkan daftar bin di gudang;
        |#White|User|
        if (Tambah Bin) then
            :Klik tombol tambah bin;
            |#White|Sistem|
            :Tampilkan form tambah bin;
            |#White|User|
            :Isi form data bin;
            :Submit form;
            |#White|Sistem|
            :Validasi data;
            if (Data valid?) then (Ya)
                :Simpan data bin ke database;
                :Tampilkan pesan sukses;
            else (Tidak)
                :Tampilkan pesan error;
            endif
        elseif (Edit Bin) then
            :Klik tombol edit bin;
            |#White|Sistem|
            :Tampilkan form edit dengan data terisi;
            |#White|User|
            :Edit data bin;
            :Submit form;
            |#White|Sistem|
            :Validasi data;
            if (Data valid?) then (Ya)
                :Update data bin di database;
                :Tampilkan pesan sukses;
            else (Tidak)
                :Tampilkan pesan error;
            endif
        elseif (Hapus Bin) then
            :Klik tombol hapus bin;
            |#White|Sistem|
            :Tampilkan konfirmasi hapus;
            |#White|User|
            if (Konfirmasi hapus?) then (Ya)
                |#White|Sistem|
                :Hapus data bin dari database;
                :Tampilkan pesan sukses;
            else (Tidak)
                :Batal hapus;
            endif
        endif
    endif
else (Lihat Detail)
    |#White|User|
    :Klik tombol lihat detail;
    |#White|Sistem|
    :Tampilkan detail data gudang;
    |#White|User|
    :Lihat detail gudang;
endif

stop

@enduml
