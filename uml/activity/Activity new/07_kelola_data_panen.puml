@startuml
' Referensi: Use Case Overview (00_use_case_overview.puml)
' Use case 07: Mengelola data panen
' Aktor: Admin/Kepala Sek, Penangkar/Kepala Satgas
!theme plain
skinparam backgroundColor white
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam swimlane {
    BackgroundColor White
    BorderColor #CCCCCC
    TitleBackgroundColor White
    TitleBorderColor #999999
}

title Activity Diagram - Mengelola data panen

|#White|User|
start
:Masuk ke halaman kelola panen;

|#White|Sistem|
:Validasi role pengguna;
:Query data panen dari database;
:Load data penanaman terkait;
:Menampilkan daftar panen;

|#White|User|
:Lihat daftar panen;

if (Pilih aksi?) then (Tambah Baru)
    |#White|User|
    :Klik tombol tambah panen;
    |#White|Sistem|
    :Tampilkan form tambah panen;
    |#White|User|
    :Pilih penanaman yang akan dipanen;
    :Isi form data panen;
    :Submit form;
    |#White|Sistem|
    :Validasi data;
    if (Data valid?) then (Ya)
        :Simpan data panen ke database;
        :Tampilkan pesan sukses;
    else (Tidak)
        :Tampilkan pesan error;
    endif
elseif (Edit) then
    |#White|User|
    :Klik tombol edit;
    |#White|Sistem|
    :Tampilkan form edit dengan data terisi;
    |#White|User|
    :Edit data panen;
    :Submit form;
    |#White|Sistem|
    :Validasi data;
    if (Data valid?) then (Ya)
        :Update data panen di database;
        :Tampilkan pesan sukses;
    else (Tidak)
        :Tampilkan pesan error;
    endif
elseif (Hapus) then
    |#White|User|
    :Klik tombol hapus;
    |#White|Sistem|
    :Tampilkan konfirmasi hapus;
    |#White|User|
    if (Konfirmasi hapus?) then (Ya)
        |#White|Sistem|
        :Hapus data panen dari database;
        :Tampilkan pesan sukses;
    else (Tidak)
        :Batal hapus;
    endif
else (Lihat Detail)
    |#White|User|
    :Klik tombol lihat detail;
    |#White|Sistem|
    :Tampilkan detail data panen;
    |#White|User|
    :Lihat detail panen;
endif

stop

@enduml
