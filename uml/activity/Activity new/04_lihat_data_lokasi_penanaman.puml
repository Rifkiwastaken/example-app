@startuml
' Referensi: Use Case Overview (00_use_case_overview.puml)
' Use case 04: Melihat data lokasi penanaman (include dari Mengelola data lokasi penanaman)
' Aktor: Penangkar/Kepala Satgas
!theme plain
skinparam backgroundColor white
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam swimlane {
    BackgroundColor White
    BorderColor #CCCCCC
    TitleBackgroundColor White
    TitleBorderColor #999999
}

title Activity Diagram - Melihat data lokasi penanaman

|#White|User|
start
:Masuk ke halaman data lokasi penanaman;

|#White|Sistem|
:Validasi role pengguna;
:Query data lokasi penanaman dari database;
:Menampilkan daftar lokasi penanaman;

|#White|User|
:Lihat daftar lokasi penanaman;

if (Filter atau cari?) then (Ya)
    |#White|User|
    :Masukkan filter atau kata kunci;
    :Submit filter;
    |#White|Sistem|
    :Query data dengan filter;
    :Tampilkan hasil filter;
else (Tidak)
endif

if (Lihat detail?) then (Ya)
    |#White|User|
    :Klik tombol lihat detail;
    |#White|Sistem|
    :Load detail data lokasi;
    :Tampilkan detail lokasi;
    |#White|User|
    :Lihat detail lokasi;
else (Tidak)
endif

stop

@enduml
