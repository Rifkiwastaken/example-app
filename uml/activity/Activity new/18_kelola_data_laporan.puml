@startuml
' Referensi: Use Case Overview (00_use_case_overview.puml)
' Use case 18: Mengelola data laporan
' Aktor: Admin/Kepala Sek, Petugas BBI
!theme plain
skinparam backgroundColor white
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam swimlane {
    BackgroundColor White
    BorderColor #CCCCCC
    TitleBackgroundColor White
    TitleBorderColor #999999
}

title Activity Diagram - Mengelola data laporan

|#White|User|
start
:Masuk ke halaman laporan;

|#White|Sistem|
:Validasi role pengguna;
:Tampilkan menu laporan;

|#White|User|
:Pilih jenis laporan;

if (Jenis laporan?) then (Laporan Penanaman)
    |#White|Sistem|
    :Query data penanaman;
    :Generate laporan penanaman;
    :Tampilkan laporan;
    |#White|User|
    :Lihat laporan penanaman;
elseif (Laporan Panen)
    |#White|Sistem|
    :Query data panen;
    :Generate laporan panen;
    :Tampilkan laporan;
    |#White|User|
    :Lihat laporan panen;
elseif (Laporan Sertifikasi)
    |#White|Sistem|
    :Query data sertifikasi;
    :Generate laporan sertifikasi;
    :Tampilkan laporan;
    |#White|User|
    :Lihat laporan sertifikasi;
elseif (Laporan Stok Benih)
    |#White|Sistem|
    :Query data stok benih;
    :Generate laporan stok;
    :Tampilkan laporan;
    |#White|User|
    :Lihat laporan stok;
elseif (Laporan Penjualan)
    |#White|Sistem|
    :Query data penjualan;
    :Generate laporan penjualan;
    :Tampilkan laporan;
    |#White|User|
    :Lihat laporan penjualan;
else (Laporan Transaksi)
    |#White|Sistem|
    :Query data transaksi;
    :Generate laporan transaksi;
    :Tampilkan laporan;
    |#White|User|
    :Lihat laporan transaksi;
endif

if (Export laporan?) then (Ya)
    |#White|User|
    :Klik tombol export;
    |#White|Sistem|
    :Generate file laporan (PDF/Excel);
    :Download file laporan;
    |#White|User|
    :Terima file laporan;
else (Tidak)
endif

stop

@enduml
