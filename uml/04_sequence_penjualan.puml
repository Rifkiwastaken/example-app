@startuml Sequence Diagram - Modul Penjualan
!theme plain
skinparam sequenceMessageAlign center
skinparam roundcorner 20
skinparam maxmessagesize 60

title Sequence Diagram - Modul Penjualan

actor "Petugas BBI" as User
participant "SaleController" as Controller
participant "Sale Model" as Sale
participant "SaleItem Model" as SaleItem
participant "InventoryType Model" as InvType
participant "InventoryLot Model" as Lot
participant "InventoryTransaction Model" as Transaction
participant "Database" as DB

' ============================================
' Use Case: Lihat Daftar Penjualan
' ============================================
== Lihat Daftar Penjualan ==

User -> Controller: GET /sales
activate Controller
Controller -> Controller: validateRole()
Controller -> Sale: with('items')->get()

activate Sale
Sale -> DB: SELECT * FROM sales\nLEFT JOIN sale_items ON ...
DB --> Sale: sales[]
Sale --> Controller: sales[]
deactivate Sale

Controller --> User: render daftar penjualan
deactivate Controller

' ============================================
' Use Case: Input Data Penjualan
' ============================================
== Input Data Penjualan ==

User -> Controller: GET /sales/create
activate Controller
Controller -> Controller: validateRole()
Controller -> InvType: with('seeds', 'lots')->get()
activate InvType
InvType -> DB: SELECT * FROM inventory_types\nLEFT JOIN inventory_type_seeds ON ...
DB --> InvType: inventory_types[]
InvType --> Controller: inventory_types[]
deactivate InvType

Controller --> User: render form input penjualan
deactivate Controller

User -> Controller: POST /sales (data penjualan + items)
activate Controller
Controller -> Controller: validate(request)
Controller -> DB: BEGIN TRANSACTION

Controller -> Sale: create(sale data)
activate Sale
Sale -> DB: INSERT INTO sales\n(receipt_number, buyer_name, total_amount=0, ...)
DB --> Sale: sale_id
Sale --> Controller: Sale
deactivate Sale

loop For each sale item
    Controller -> InvType: find(inventory_type_id)
    activate InvType
    InvType -> DB: SELECT * FROM inventory_types WHERE id = ?
    DB --> InvType: inventory_type data
    InvType --> Controller: InvType
    deactivate InvType
    
    Controller -> Controller: checkStockAvailable(inventory_type_id, quantity)
    Controller -> Lot: where('inventory_type_id', id)\n->orderBy('expiry_date', 'asc')->get()
    activate Lot
    Lot -> DB: SELECT * FROM inventory_lots\nWHERE inventory_type_id = ?\nORDER BY expiry_date ASC
    DB --> Lot: lots[]
    Lot --> Controller: lots[]
    deactivate Lot
    
    alt Stok Cukup
        Controller -> Controller: processFIFO(lots, quantity)
        Controller -> SaleItem: create(item data)
        activate SaleItem
        SaleItem -> DB: INSERT INTO sale_items\n(sale_id, inventory_type_id, quantity, unit_price, ...)
        DB --> SaleItem: sale_item_id
        SaleItem --> Controller: SaleItem
        deactivate SaleItem
        
        loop For each lot (FIFO)
            Controller -> Lot: update(['current_stock' => current - quantity])
            activate Lot
            Lot -> DB: UPDATE inventory_lots\nSET current_stock = ? WHERE id = ?
            DB --> Lot: updated
            Lot --> Controller: updated
            deactivate Lot
        endloop
        
        Controller -> Transaction: create(['transaction_type' => 'penjualan', ...])
        activate Transaction
        Transaction -> DB: INSERT INTO inventory_transactions\n(transaction_type, quantity, ...)
        DB --> Transaction: transaction_id
        Transaction --> Controller: created
        deactivate Transaction
    else Stok Tidak Cukup
        Controller -> DB: ROLLBACK TRANSACTION
        Controller --> User: error: stok tidak cukup untuk item
    endif
endloop

Controller -> Sale: update(['total_amount' => sum(subtotal)])
activate Sale
Sale -> DB: UPDATE sales SET total_amount = ? WHERE id = ?
DB --> Sale: updated
Sale --> Controller: updated
deactivate Sale

Controller -> DB: COMMIT TRANSACTION
Controller --> User: redirect with success message
deactivate Controller

' ============================================
' Use Case: Pilih List untuk dijual
' ============================================
== Pilih List untuk dijual ==

User -> Controller: GET /sales/get-bin-lots?bin_id={id}
activate Controller
Controller -> Controller: validateRole()
Controller -> Lot: where('bin_id', id)->with('inventoryType')->get()
activate Lot
Lot -> DB: SELECT * FROM inventory_lots\nLEFT JOIN inventory_types ON ...\nWHERE bin_id = ?
DB --> Lot: lots[]
Lot --> Controller: lots[]
deactivate Lot

Controller --> User: JSON response (lots[])
deactivate Controller

User -> Controller: GET /sales/inventory-types/{id}
activate Controller
Controller -> InvType: find(id)
activate InvType
InvType -> DB: SELECT * FROM inventory_types WHERE id = ?
DB --> InvType: inventory_type data
InvType --> Controller: InvType
deactivate InvType

Controller -> Lot: where('inventory_type_id', id)\n->where('current_stock', '>', 0)->get()
activate Lot
Lot -> DB: SELECT * FROM inventory_lots\nWHERE inventory_type_id = ? AND current_stock > 0
DB --> Lot: lots[]
Lot --> Controller: lots[]
deactivate Lot

Controller --> User: render form dengan stok tersedia
deactivate Controller

' ============================================
' Use Case: Proses Penjualan
' ============================================
== Proses Penjualan ==

User -> Controller: POST /sales (finalize sale)
activate Controller
Controller -> Controller: validateAllItems()
Controller -> DB: BEGIN TRANSACTION

loop For each item
    Controller -> Controller: validateStock(item)
    Controller -> Controller: applyFIFO(item)
endloop

alt All Items Valid
    Controller -> Sale: create(sale data)
    activate Sale
    Sale -> DB: INSERT INTO sales (...)
    DB --> Sale: sale_id
    Sale --> Controller: Sale
    deactivate Sale
    
    loop For each item
        Controller -> SaleItem: create(item data)
        activate SaleItem
        SaleItem -> DB: INSERT INTO sale_items (...)
        DB --> SaleItem: sale_item_id
        SaleItem --> Controller: SaleItem
        deactivate SaleItem
        
        Controller -> Lot: updateStockFIFO(item)
        activate Lot
        Lot -> DB: UPDATE inventory_lots SET current_stock = ? WHERE id = ?
        DB --> Lot: updated
        Lot --> Controller: updated
        deactivate Lot
    endloop
    
    Controller -> DB: COMMIT TRANSACTION
    Controller --> User: redirect with success + nota
else Some Items Invalid
    Controller -> DB: ROLLBACK TRANSACTION
    Controller --> User: error: ada item yang stok tidak cukup
endif
deactivate Controller

' ============================================
' Use Case: Batalkan Penjualan
' ============================================
== Batalkan Penjualan ==

User -> Controller: DELETE /sales/{id}
activate Controller
Controller -> Controller: validateRole()
Controller -> Sale: find(id)
activate Sale
Sale -> DB: SELECT * FROM sales WHERE id = ?
DB --> Sale: sale data
Sale --> Controller: Sale
deactivate Sale

Controller -> SaleItem: where('sale_id', id)->get()
activate SaleItem
SaleItem -> DB: SELECT * FROM sale_items WHERE sale_id = ?
DB --> SaleItem: sale_items[]
SaleItem --> Controller: sale_items[]
deactivate SaleItem

alt Penjualan Dapat Dibatalkan
    Controller -> DB: BEGIN TRANSACTION
    
    loop For each sale item
        Controller -> Lot: restoreStock(item)
        activate Lot
        Lot -> DB: UPDATE inventory_lots\nSET current_stock = current_stock + ? WHERE id = ?
        DB --> Lot: updated
        Lot --> Controller: updated
        deactivate Lot
        
        Controller -> Transaction: create(['transaction_type' => 'pembatalan', ...])
        activate Transaction
        Transaction -> DB: INSERT INTO inventory_transactions (...)
        DB --> Transaction: transaction_id
        Transaction --> Controller: created
        deactivate Transaction
    endloop
    
    Controller -> Sale: update(['status' => 'dibatalkan'])
    activate Sale
    Sale -> DB: UPDATE sales SET status='dibatalkan' WHERE id = ?
    DB --> Sale: updated
    Sale --> Controller: updated
    deactivate Sale
    
    Controller -> DB: COMMIT TRANSACTION
    Controller --> User: redirect with success message
else Penjualan Tidak Dapat Dibatalkan
    Controller --> User: error: penjualan tidak dapat dibatalkan
endif
deactivate Controller

@enduml
