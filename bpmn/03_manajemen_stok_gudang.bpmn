<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_3" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="ProsesManajemenStok" name="Proses Manajemen Stok dan Gudang" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Stok" name="Mulai Proses Manajemen Stok">
      <bpmn:outgoing>Flow_PilihAksi</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_PilihAksi" name="Pilih Aksi">
      <bpmn:incoming>Flow_PilihAksi</bpmn:incoming>
      <bpmn:outgoing>Flow_TambahStok</bpmn:outgoing>
      <bpmn:outgoing>Flow_KelolaGudang</bpmn:outgoing>
      <bpmn:outgoing>Flow_AdjustmentStok</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PilihTanaman" name="Pengguna Memilih Tanaman untuk Stok">
      <bpmn:incoming>Flow_TambahStok</bpmn:incoming>
      <bpmn:outgoing>Flow_InputDataStok</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_InputDataStok" name="Pengguna Mengisi Data Stok (SKU, Unit, dll)">
      <bpmn:incoming>Flow_InputDataStok</bpmn:incoming>
      <bpmn:outgoing>Flow_PilihGudang</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PilihGudang" name="Pengguna Memilih Gudang dan Bin">
      <bpmn:incoming>Flow_PilihGudang</bpmn:incoming>
      <bpmn:outgoing>Flow_InputLot</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_InputLot" name="Pengguna Mengisi Data Lot (Batch Number, Tanggal Produksi)">
      <bpmn:incoming>Flow_InputLot</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidasiStok</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidasiStok" name="Memvalidasi Data Stok">
      <bpmn:incoming>Flow_ValidasiStok</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckSKU</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckSKU" name="Memeriksa SKU Unik di Database">
      <bpmn:incoming>Flow_CheckSKU</bpmn:incoming>
      <bpmn:outgoing>Flow_GatewayValidasiStok</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ValidasiStok" name="Data Valid?">
      <bpmn:incoming>Flow_GatewayValidasiStok</bpmn:incoming>
      <bpmn:outgoing>Flow_StokValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_StokTidakValid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SimpanInventoryType" name="Menyimpan Tipe Inventory ke Database">
      <bpmn:incoming>Flow_StokValid</bpmn:incoming>
      <bpmn:outgoing>Flow_InsertInventoryType</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_InsertInventoryType" name="Menyimpan ke Tabel Inventory Types">
      <bpmn:incoming>Flow_InsertInventoryType</bpmn:incoming>
      <bpmn:outgoing>Flow_SimpanLot</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SimpanLot" name="Menyimpan Data Lot ke Database">
      <bpmn:incoming>Flow_SimpanLot</bpmn:incoming>
      <bpmn:outgoing>Flow_InsertInventoryLot</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_InsertInventoryLot" name="Menyimpan ke Tabel Inventory Lots">
      <bpmn:incoming>Flow_InsertInventoryLot</bpmn:incoming>
      <bpmn:outgoing>Flow_CatatTransaksi</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CatatTransaksi" name="Mencatat Transaksi Inventory">
      <bpmn:incoming>Flow_CatatTransaksi</bpmn:incoming>
      <bpmn:outgoing>Flow_InsertTransaction</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_InsertTransaction" name="Menyimpan ke Tabel Inventory Transactions">
      <bpmn:incoming>Flow_InsertTransaction</bpmn:incoming>
      <bpmn:outgoing>Flow_EndTambahStok</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_BuatGudang" name="Pengguna Membuat Gudang Baru">
      <bpmn:incoming>Flow_KelolaGudang</bpmn:incoming>
      <bpmn:outgoing>Flow_InputDataGudang</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_InputDataGudang" name="Pengguna Mengisi Data Gudang">
      <bpmn:incoming>Flow_InputDataGudang</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidasiGudang</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidasiGudang" name="Memvalidasi Data Gudang">
      <bpmn:incoming>Flow_ValidasiGudang</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckInternalID</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckInternalID" name="Memeriksa Internal ID Unik di Database">
      <bpmn:incoming>Flow_CheckInternalID</bpmn:incoming>
      <bpmn:outgoing>Flow_GatewayValidasiGudang</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ValidasiGudang" name="Data Valid?">
      <bpmn:incoming>Flow_GatewayValidasiGudang</bpmn:incoming>
      <bpmn:outgoing>Flow_GudangValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_GudangTidakValid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SimpanGudang" name="Menyimpan Data Gudang ke Database">
      <bpmn:incoming>Flow_GudangValid</bpmn:incoming>
      <bpmn:outgoing>Flow_InsertWarehouse</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_InsertWarehouse" name="Menyimpan ke Tabel Warehouses">
      <bpmn:incoming>Flow_InsertWarehouse</bpmn:incoming>
      <bpmn:outgoing>Flow_BuatBin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_BuatBin" name="Pengguna Membuat Bin di Gudang">
      <bpmn:incoming>Flow_BuatBin</bpmn:incoming>
      <bpmn:outgoing>Flow_InputDataBin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_InputDataBin" name="Pengguna Mengisi Data Bin">
      <bpmn:incoming>Flow_InputDataBin</bpmn:incoming>
      <bpmn:outgoing>Flow_SimpanBin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SimpanBin" name="Menyimpan Data Bin ke Database">
      <bpmn:incoming>Flow_SimpanBin</bpmn:incoming>
      <bpmn:outgoing>Flow_InsertBin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_InsertBin" name="Menyimpan ke Tabel Bins">
      <bpmn:incoming>Flow_InsertBin</bpmn:incoming>
      <bpmn:outgoing>Flow_EndKelolaGudang</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_InputAdjustment" name="Pengguna Mengisi Data Adjustment Stok">
      <bpmn:incoming>Flow_AdjustmentStok</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidasiAdjustment</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidasiAdjustment" name="Memvalidasi Data Adjustment">
      <bpmn:incoming>Flow_ValidasiAdjustment</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckStokTersedia</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckStokTersedia" name="Memeriksa Stok Tersedia di Database">
      <bpmn:incoming>Flow_CheckStokTersedia</bpmn:incoming>
      <bpmn:outgoing>Flow_GatewayValidasiAdjustment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ValidasiAdjustment" name="Stok Cukup?">
      <bpmn:incoming>Flow_GatewayValidasiAdjustment</bpmn:incoming>
      <bpmn:outgoing>Flow_StokCukup</bpmn:outgoing>
      <bpmn:outgoing>Flow_StokTidakCukup</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_UpdateStok" name="Memperbarui Stok di Database">
      <bpmn:incoming>Flow_StokCukup</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateInventoryLot</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateInventoryLot" name="Update Stok di Tabel Inventory Lots">
      <bpmn:incoming>Flow_UpdateInventoryLot</bpmn:incoming>
      <bpmn:outgoing>Flow_CatatTransaksiAdjustment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CatatTransaksiAdjustment" name="Mencatat Transaksi Adjustment">
      <bpmn:incoming>Flow_CatatTransaksiAdjustment</bpmn:incoming>
      <bpmn:outgoing>Flow_InsertTransactionAdjustment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_InsertTransactionAdjustment" name="Menyimpan Transaksi Adjustment">
      <bpmn:incoming>Flow_InsertTransactionAdjustment</bpmn:incoming>
      <bpmn:outgoing>Flow_EndAdjustment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_TambahStok" name="Stok Berhasil Ditambahkan">
      <bpmn:incoming>Flow_EndTambahStok</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_KelolaGudang" name="Gudang Berhasil Dikelola">
      <bpmn:incoming>Flow_EndKelolaGudang</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Adjustment" name="Adjustment Stok Selesai">
      <bpmn:incoming>Flow_EndAdjustment</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_StokTidakValid" name="Data Stok Tidak Valid">
      <bpmn:incoming>Flow_StokTidakValid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_GudangTidakValid" name="Data Gudang Tidak Valid">
      <bpmn:incoming>Flow_GudangTidakValid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_StokTidakCukup" name="Stok Tidak Cukup">
      <bpmn:incoming>Flow_StokTidakCukup</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStore id="Database" name="Database" />
    <bpmn:dataStoreReference id="DataStore_Database" name="Database">
      <bpmn:dataStoreRef>Database</bpmn:dataStoreRef>
    </bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="Flow_PilihAksi" sourceRef="StartEvent_Stok" targetRef="Gateway_PilihAksi" />
    <bpmn:sequenceFlow id="Flow_TambahStok" name="Tambah Stok" sourceRef="Gateway_PilihAksi" targetRef="Task_PilihTanaman" />
    <bpmn:sequenceFlow id="Flow_KelolaGudang" name="Kelola Gudang" sourceRef="Gateway_PilihAksi" targetRef="Task_BuatGudang" />
    <bpmn:sequenceFlow id="Flow_AdjustmentStok" name="Adjustment Stok" sourceRef="Gateway_PilihAksi" targetRef="Task_InputAdjustment" />
    <bpmn:sequenceFlow id="Flow_InputDataStok" sourceRef="Task_PilihTanaman" targetRef="Task_InputDataStok" />
    <bpmn:sequenceFlow id="Flow_PilihGudang" sourceRef="Task_InputDataStok" targetRef="Task_PilihGudang" />
    <bpmn:sequenceFlow id="Flow_InputLot" sourceRef="Task_PilihGudang" targetRef="Task_InputLot" />
    <bpmn:sequenceFlow id="Flow_ValidasiStok" sourceRef="Task_InputLot" targetRef="Task_ValidasiStok" />
    <bpmn:sequenceFlow id="Flow_CheckSKU" sourceRef="Task_ValidasiStok" targetRef="Task_CheckSKU" />
    <bpmn:sequenceFlow id="Flow_GatewayValidasiStok" sourceRef="Task_CheckSKU" targetRef="Gateway_ValidasiStok" />
    <bpmn:sequenceFlow id="Flow_StokValid" name="Ya" sourceRef="Gateway_ValidasiStok" targetRef="Task_SimpanInventoryType" />
    <bpmn:sequenceFlow id="Flow_StokTidakValid" name="Tidak" sourceRef="Gateway_ValidasiStok" targetRef="EndEvent_StokTidakValid" />
    <bpmn:sequenceFlow id="Flow_InsertInventoryType" sourceRef="Task_SimpanInventoryType" targetRef="Task_InsertInventoryType" />
    <bpmn:sequenceFlow id="Flow_SimpanLot" sourceRef="Task_InsertInventoryType" targetRef="Task_SimpanLot" />
    <bpmn:sequenceFlow id="Flow_InsertInventoryLot" sourceRef="Task_SimpanLot" targetRef="Task_InsertInventoryLot" />
    <bpmn:sequenceFlow id="Flow_CatatTransaksi" sourceRef="Task_InsertInventoryLot" targetRef="Task_CatatTransaksi" />
    <bpmn:sequenceFlow id="Flow_InsertTransaction" sourceRef="Task_CatatTransaksi" targetRef="Task_InsertTransaction" />
    <bpmn:sequenceFlow id="Flow_EndTambahStok" sourceRef="Task_InsertTransaction" targetRef="EndEvent_TambahStok" />
    <bpmn:sequenceFlow id="Flow_InputDataGudang" sourceRef="Task_BuatGudang" targetRef="Task_InputDataGudang" />
    <bpmn:sequenceFlow id="Flow_ValidasiGudang" sourceRef="Task_InputDataGudang" targetRef="Task_ValidasiGudang" />
    <bpmn:sequenceFlow id="Flow_CheckInternalID" sourceRef="Task_ValidasiGudang" targetRef="Task_CheckInternalID" />
    <bpmn:sequenceFlow id="Flow_GatewayValidasiGudang" sourceRef="Task_CheckInternalID" targetRef="Gateway_ValidasiGudang" />
    <bpmn:sequenceFlow id="Flow_GudangValid" name="Ya" sourceRef="Gateway_ValidasiGudang" targetRef="Task_SimpanGudang" />
    <bpmn:sequenceFlow id="Flow_GudangTidakValid" name="Tidak" sourceRef="Gateway_ValidasiGudang" targetRef="EndEvent_GudangTidakValid" />
    <bpmn:sequenceFlow id="Flow_InsertWarehouse" sourceRef="Task_SimpanGudang" targetRef="Task_InsertWarehouse" />
    <bpmn:sequenceFlow id="Flow_BuatBin" sourceRef="Task_InsertWarehouse" targetRef="Task_BuatBin" />
    <bpmn:sequenceFlow id="Flow_InputDataBin" sourceRef="Task_BuatBin" targetRef="Task_InputDataBin" />
    <bpmn:sequenceFlow id="Flow_SimpanBin" sourceRef="Task_InputDataBin" targetRef="Task_SimpanBin" />
    <bpmn:sequenceFlow id="Flow_InsertBin" sourceRef="Task_SimpanBin" targetRef="Task_InsertBin" />
    <bpmn:sequenceFlow id="Flow_EndKelolaGudang" sourceRef="Task_InsertBin" targetRef="EndEvent_KelolaGudang" />
    <bpmn:sequenceFlow id="Flow_ValidasiAdjustment" sourceRef="Task_InputAdjustment" targetRef="Task_ValidasiAdjustment" />
    <bpmn:sequenceFlow id="Flow_CheckStokTersedia" sourceRef="Task_ValidasiAdjustment" targetRef="Task_CheckStokTersedia" />
    <bpmn:sequenceFlow id="Flow_GatewayValidasiAdjustment" sourceRef="Task_CheckStokTersedia" targetRef="Gateway_ValidasiAdjustment" />
    <bpmn:sequenceFlow id="Flow_StokCukup" name="Ya" sourceRef="Gateway_ValidasiAdjustment" targetRef="Task_UpdateStok" />
    <bpmn:sequenceFlow id="Flow_StokTidakCukup" name="Tidak" sourceRef="Gateway_ValidasiAdjustment" targetRef="EndEvent_StokTidakCukup" />
    <bpmn:sequenceFlow id="Flow_UpdateInventoryLot" sourceRef="Task_UpdateStok" targetRef="Task_UpdateInventoryLot" />
    <bpmn:sequenceFlow id="Flow_CatatTransaksiAdjustment" sourceRef="Task_UpdateInventoryLot" targetRef="Task_CatatTransaksiAdjustment" />
    <bpmn:sequenceFlow id="Flow_InsertTransactionAdjustment" sourceRef="Task_CatatTransaksiAdjustment" targetRef="Task_InsertTransactionAdjustment" />
    <bpmn:sequenceFlow id="Flow_EndAdjustment" sourceRef="Task_InsertTransactionAdjustment" targetRef="EndEvent_Adjustment" />
    <bpmn:association id="Association_CheckSKU" sourceRef="Task_CheckSKU" targetRef="DataStore_Database" />
    <bpmn:association id="Association_InsertInventoryType" sourceRef="Task_InsertInventoryType" targetRef="DataStore_Database" />
    <bpmn:association id="Association_InsertInventoryLot" sourceRef="Task_InsertInventoryLot" targetRef="DataStore_Database" />
    <bpmn:association id="Association_InsertTransaction" sourceRef="Task_InsertTransaction" targetRef="DataStore_Database" />
    <bpmn:association id="Association_CheckInternalID" sourceRef="Task_CheckInternalID" targetRef="DataStore_Database" />
    <bpmn:association id="Association_InsertWarehouse" sourceRef="Task_InsertWarehouse" targetRef="DataStore_Database" />
    <bpmn:association id="Association_InsertBin" sourceRef="Task_InsertBin" targetRef="DataStore_Database" />
    <bpmn:association id="Association_CheckStokTersedia" sourceRef="Task_CheckStokTersedia" targetRef="DataStore_Database" />
    <bpmn:association id="Association_UpdateInventoryLot" sourceRef="Task_UpdateInventoryLot" targetRef="DataStore_Database" />
    <bpmn:association id="Association_InsertTransactionAdjustment" sourceRef="Task_InsertTransactionAdjustment" targetRef="DataStore_Database" />
  </bpmn:process>
