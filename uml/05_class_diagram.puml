@startuml Class Diagram - SIBESTI
!theme plain


skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 18
skinparam ranksep 28
skinparam packagePadding 10
skinparam Padding 5
skinparam ArrowColor #333333
skinparam ClassBorderColor #444444
skinparam dpi 100

left to right direction

title Class Diagram SIBESTI

' ============================================================
package "Model (Domain)" #F5F5F5 {

  package "User & lokasi" #E3F2FD {
  class User {
      -user_id: string
      -email: string
      -role: string
      -location_id: string
      --
      +location(): BelongsTo
      +workedPlantingLocations(): BelongsToMany
      +managedPlantingLocations(): BelongsToMany
    }
    class Location {
      -location_id: string
      -name: string
      --
      +users(): HasMany
    }
    class UserPlantingLocationLandWorkerPivot <<Pivot>> {
      -user_id: string
      -planting_location_id: string
      -role: string
    }
  }

  package "Penanaman" #E8F5E9 {
  class PlantType {
      -plant_type_id: string
      -name: string
      -category: string
      --
      +plants(): HasMany
    }
  class Plant {
      -plant_id: string
      -plant_type_id: string
      -name: string
      --
      +type(): BelongsTo
      +plantings(): HasMany
      +harvests(): HasManyThrough
      +notes() / photos() / certifications()
    }
  class PlantingLocation {
      -planting_location_id: string
      -name: string
      --
      +plantings(): HasMany
      +landWorkerUsers(): BelongsToMany
      +attachments(): HasMany
    }
  class Planting {
      -planting_id: string
      -plant_id: string
      -planting_location_id: string
      -planting_amount: decimal
      -progress: int
      --
      +plant() / location(): BelongsTo
      +harvests(): HasMany
      +losses() / expenses(): HasMany
    }
  class Harvest {
      -harvest_id: string
      -planting_id: string
      -harvested_at: date
      -quantity: decimal
      --
      +planting(): BelongsTo
      +plant() / location(): HasOneThrough
      +certificationReports(): HasMany
    }
    class PlantingLocationNote <<planting_notes>> {
      -planting_note_id: string
      -planting_id: string
      --
      +planting(): BelongsTo
      +plantingLocation(): HasOneThrough
    }
    class Task <<planting_tasks>> {
      -planting_task_id: string
      -planting_id: string
      -task_template_id: string
      --
      +planting(): BelongsTo
      +plantingLocation(): HasOneThrough
    }
    class TaskTemplate {
      -task_template_id: string
      -name: string
      --
      +tasks(): HasMany
    }
    class Attachment <<planting_attachments>> {
      -planting_attachment_id: string
      -planting_location_id: string
      --
      +plantingLocation(): BelongsTo
    }
    class Expense {
      -planting_id: string
      --
      +planting(): BelongsTo
    }
  class Treatment {
      -planting_id: string
      --
      +planting(): BelongsTo
    }
  class Nutrient {
      -planting_id: string
      --
      +planting(): BelongsTo
    }
  }

  package "Sertifikasi & stok benih" #E1F5FE {
    class Certification <<legacy>> {
      -certification_id: string
      -harvest_id: string
      --
      +harvest(): BelongsTo
    }
    class CertificationReport {
      -certification_report_id: string
      -harvest_id: string
      -inventory_type_id: string
      -report_date: date
      -conclusion: string
      --
      +harvest() / inventoryType(): BelongsTo
    }
    class InventoryType {
      -inventory_type_id: string
      -name: string
      -category: string
      --
      +lots(): HasMany
      +certificationReports(): HasMany
      +latestCertificationReport(): BelongsTo
    }
  }

  package "Gudang & mutasi" #E0F2F1 {
    class Warehouse {
      -warehouse_id: string
      -name: string
      --
      +bins(): HasMany
    }
    class Bin <<warehouse_bins>> {
      -warehouse_bin_id: string
      -warehouse_id: string
      --
      +warehouse(): BelongsTo
      +inventoryLots(): HasMany
    }
    class InventoryLot <<warehouse_lots>> {
      -warehouse_lot_id: string
      -warehouse_bin_id: string
      -inventory_type_id: string
      -current_stock: decimal
      --
      +inventoryType() / bin(): BelongsTo
      +warehouse(): HasOneThrough
      +transactions(): HasMany
    }
    class StockHistory <<stock_histories>> {
      -stock_history_id: string
      -warehouse_lot_id: string
      -transaction_type: string
      --
      +inventoryLot() / inventoryType() / user()
    }
  }

  package "Penjualan & lainnya" #F3E5F5 {
    class SaleItem {
      -sale_item_id: string
      -warehouse_lot_id: string
      -receipt_number: string
      -quantity: decimal
      --
      +inventoryLot(): BelongsTo
      +inventoryType(): HasOneThrough
      +user(): BelongsTo
    }
    class LandingPageSetting {
      -key: string
      -value: string
    }
  }
}

' --- Relasi antar model (garis penuh) ---
User "1" --> "0..1" Location
User "1" *-- "many" UserPlantingLocationLandWorkerPivot
PlantingLocation "1" *-- "many" UserPlantingLocationLandWorkerPivot

PlantType "1" *-- "many" Plant
Plant "1" *-- "many" Planting
PlantingLocation "1" *-- "many" Planting
Planting "1" *-- "many" Harvest
Planting "1" *-- "many" Task
Planting "1" *-- "many" Expense
Planting "1" *-- "many" Treatment
Planting "1" *-- "many" Nutrient
Planting "1" *-- "many" PlantingLocationNote
TaskTemplate "1" *-- "many" Task
PlantingLocation "1" *-- "many" Attachment

Harvest "1" *-- "many" CertificationReport
Harvest "1" *-- "many" Certification
CertificationReport "many" --> "0..1" InventoryType
InventoryType "1" *-- "many" CertificationReport
InventoryType "1" *-- "many" InventoryLot

Warehouse "1" *-- "many" Bin
Bin "1" *-- "many" InventoryLot
InventoryLot "1" *-- "many" StockHistory
InventoryType "1" *-- "many" StockHistory

SaleItem --> InventoryLot
SaleItem --> User




@enduml
