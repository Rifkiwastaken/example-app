@startuml Sequence Diagram - Proses Penjualan
!theme plain
skinparam sequenceMessageAlign center
skinparam roundcorner 20
skinparam maxmessagesize 60

title Sequence Diagram - Proses Penjualan

actor "Petugas BBI" as User
participant "SaleController" as Controller
participant "Sale Model" as Sale
participant "SaleItem Model" as SaleItem
participant "InventoryLot Model" as Lot
participant "InventoryTransaction Model" as Transaction
participant "Database" as DB

User -> Controller: POST /sales/process sale data items
activate Controller
Controller -> Controller: validate
Controller -> Controller: validateAllItems

loop For each item
    Controller -> Lot: getTotalAvailable
    activate Lot
    Lot -> DB: SELECT SUM(quantity) FROM inventory_lots WHERE inventory_type_id = ?
    DB --> Lot: total_available
    Lot --> Controller: total_available
    deactivate Lot
    
    Controller -> Controller: checkQuantity
end

alt All Items Valid
    Controller -> DB: BEGIN TRANSACTION
    
    Controller -> Sale: create sale data
    activate Sale
    Sale -> DB: INSERT INTO sales customer_name customer_contact total_amount
    DB --> Sale: sale_id
    Sale --> Controller: Sale
    deactivate Sale
    
    loop For each item
        Controller -> SaleItem: create item data
        activate SaleItem
        SaleItem -> DB: INSERT INTO sale_items sale_id inventory_type_id quantity
        DB --> SaleItem: item_id
        SaleItem --> Controller: SaleItem
        deactivate SaleItem
        
        Controller -> Lot: reduceStockFIFO
        activate Lot
        Lot -> DB: SELECT * FROM inventory_lots WHERE inventory_type_id = ? ORDER BY created_at ASC
        DB --> Lot: lots[]
        
        loop Reduce stock FIFO
            alt Quantity Less Equal Lot Quantity
                Lot -> DB: UPDATE inventory_lots SET quantity = quantity - ? WHERE id = ?
                DB --> Lot: updated
            else Quantity Greater Lot Quantity
                Lot -> DB: UPDATE inventory_lots SET quantity = 0 status = sold WHERE id = ?
                DB --> Lot: updated
                Lot -> Lot: reduceRemaining
            end
        end
        Lot --> Controller: stock_reduced
        deactivate Lot
        
        Controller -> Transaction: create transaction sale
        activate Transaction
        Transaction -> DB: INSERT INTO inventory_transactions inventory_lot_id transaction_type quantity
        DB --> Transaction: transaction_id
        Transaction --> Controller: created
        deactivate Transaction
    end
    
    Controller -> DB: COMMIT TRANSACTION
    Controller --> User: response success
else Not Valid
    Controller -> DB: ROLLBACK TRANSACTION
    Controller --> User: show form
end
deactivate Controller

@enduml

