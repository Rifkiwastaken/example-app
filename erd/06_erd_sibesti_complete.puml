        FOREIGN_KEY(planting_location_id) : VARCHAR(36)
        FOREIGN_KEY(user_id) : VARCHAR(36)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }
}

' =====================================================
' 9. LANDING PAGE
' =====================================================
package "Landing Page" {
    TABLE(landing_page_settings) {
        PRIMARY_KEY(landing_page_setting_id) : VARCHAR(36)
        --
        key_name : VARCHAR(100) <<UNIQUE>>
        value : TEXT
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }
}

