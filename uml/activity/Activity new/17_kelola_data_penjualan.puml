@startuml
' Referensi: Use Case Overview (00_use_case_overview.puml)
' Use case 17: Mengelola data penjualan
' Aktor: Admin/Kepala Sek, Petugas BBI
!theme plain
skinparam backgroundColor white
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam swimlane {
    BackgroundColor White
    BorderColor #CCCCCC
    TitleBackgroundColor White
    TitleBorderColor #999999
}

title Activity Diagram - Mengelola data penjualan

|#White|User|
start
:Masuk ke halaman kelola penjualan;

|#White|Sistem|
:Validasi role pengguna;
:Query data penjualan dari database;
:Load data stok benih terkait;
:Menampilkan daftar penjualan;

|#White|User|
:Lihat daftar penjualan;

if (Pilih aksi?) then (Tambah Baru)
    |#White|User|
    :Klik tombol tambah penjualan;
    |#White|Sistem|
    :Tampilkan form tambah penjualan;
    |#White|User|
    :Isi data pembeli;
    :Isi data lokasi sebaran;
    :Pilih stok benih yang akan dijual;
    :Isi jumlah penjualan;
    :Submit form;
    |#White|Sistem|
    :Validasi data;
    if (Data valid?) then (Ya)
        :Check ketersediaan stok;
        if (Stok cukup?) then (Tidak)
            :Tampilkan pesan error;
            stop
        endif
        :Simpan data penjualan ke database;
        :Kurangi stok benih;
        :Update stok di bin;
        :Tampilkan pesan sukses;
    else (Tidak)
        :Tampilkan pesan error;
    endif
elseif (Edit) then
    |#White|User|
    :Klik tombol edit;
    |#White|Sistem|
    :Tampilkan form edit dengan data terisi;
    |#White|User|
    :Edit data penjualan;
    :Submit form;
    |#White|Sistem|
    :Validasi data;
    if (Data valid?) then (Ya)
        :Update data penjualan di database;
        :Tampilkan pesan sukses;
    else (Tidak)
        :Tampilkan pesan error;
    endif
elseif (Batalkan) then
    |#White|User|
    :Klik tombol batalkan;
    |#White|Sistem|
    :Tampilkan konfirmasi batalkan;
    |#White|User|
    if (Konfirmasi batalkan?) then (Ya)
        |#White|Sistem|
        :Update status penjualan;
        :Kembalikan stok benih;
        :Update stok di bin;
        :Tampilkan pesan sukses;
    else (Tidak)
        :Batal batalkan;
    endif
else (Lihat Detail)
    |#White|User|
    :Klik tombol lihat detail;
    |#White|Sistem|
    :Tampilkan detail data penjualan;
    |#White|User|
    :Lihat detail penjualan;
endif

stop

@enduml
