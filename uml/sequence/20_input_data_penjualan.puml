@startuml
!theme plain
skinparam sequenceMessageAlign center
skinparam roundcorner 20
skinparam maxmessagesize 60

' sd Input Data Penjualan

actor "Petugas BBI" as User
participant "SaleController" as Controller
participant "Sale" as Sale
participant "SaleItem" as SaleItem
participant "InventoryType" as InvType
participant "InventoryLot" as Lot
participant "Warehouse" as Warehouse
participant "Database" as DB

User -> User: akses halaman input penjualan()
User -> Controller: create()
activate Controller
Controller -> Controller: validateRole()
Controller -> Warehouse: Warehouse::get()
activate Warehouse
Warehouse -> DB: SELECT * FROM warehouses
DB --> Warehouse: return warehouses[]
Warehouse --> Controller: return warehouses[]
deactivate Warehouse

Controller -> InvType: InventoryType::where('status', 'available')->get()
activate InvType
InvType -> DB: SELECT * FROM inventory_types WHERE status = 'available'
DB --> InvType: return inventory_types[]
InvType --> Controller: return inventory_types[]
deactivate InvType

Controller --> User: return view create dengan data()
deactivate Controller
User -> User: tampilkan form input penjualan()

User -> User: isi data penjualan()
User -> User: pilih list untuk dijual()
User -> Controller: store(Request)
activate Controller
Controller -> Controller: validate(Request)
Controller -> Controller: validateStock()

loop For each item
    Controller -> Lot: InventoryLot::where('inventory_type_id', type_id)->orderBy('created_at', 'ASC')->get()
    activate Lot
    Lot -> DB: SELECT * FROM inventory_lots WHERE inventory_type_id = ? ORDER BY created_at ASC
    DB --> Lot: return lots[]
    Lot --> Controller: return lots[]
    deactivate Lot
    
    Controller -> Controller: checkAvailableQuantity()
end

alt Semua Item Valid
    Controller -> DB: BEGIN TRANSACTION
    
    Controller -> Sale: Sale::create(data)
    activate Sale
    Sale -> DB: INSERT INTO sales VALUES
    DB --> Sale: return sale_id
    Sale --> Controller: return Sale
    deactivate Sale
    
    loop For each item
        Controller -> SaleItem: SaleItem::create(data)
        activate SaleItem
        SaleItem -> DB: INSERT INTO sale_items VALUES
        DB --> SaleItem: return item_id
        SaleItem --> Controller: return SaleItem
        deactivate SaleItem
        
        Controller -> Lot: reduceStockFIFO()
        activate Lot
        loop Reduce stock FIFO
            Lot -> DB: UPDATE inventory_lots SET quantity = quantity - ? WHERE id = ?
            DB --> Lot: return updated
        end
        Lot --> Controller: return stock_reduced
        deactivate Lot
    end
    
    Controller -> DB: COMMIT TRANSACTION
    Controller --> User: redirect back dengan success message()
    User -> User: tampilkan pesan penjualan berhasil dibuat()
else Ada Item Tidak Valid
    Controller -> DB: ROLLBACK TRANSACTION
    Controller --> User: redirect back dengan error message()
    User -> User: tampilkan pesan stok tidak cukup()
end
deactivate Controller

@enduml
