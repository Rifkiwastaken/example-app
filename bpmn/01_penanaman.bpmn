<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="ProsesPenanaman" name="Proses Penanaman" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Penanaman" name="Mulai Proses Penanaman">
      <bpmn:outgoing>Flow_LoadDataTanaman</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_LoadDataTanaman" name="Mengambil Data Tanaman dan Lokasi">
      <bpmn:incoming>Flow_LoadDataTanaman</bpmn:incoming>
      <bpmn:outgoing>Flow_QueryPlants</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_QueryPlants" name="Mengambil Daftar Tanaman dari Database">
      <bpmn:incoming>Flow_QueryPlants</bpmn:incoming>
      <bpmn:outgoing>Flow_QueryLocations</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_QueryLocations" name="Mengambil Daftar Lokasi dari Database">
      <bpmn:incoming>Flow_QueryLocations</bpmn:incoming>
      <bpmn:outgoing>Flow_RenderForm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_RenderForm" name="Menampilkan Form Input Penanaman">
      <bpmn:incoming>Flow_RenderForm</bpmn:incoming>
      <bpmn:outgoing>Flow_UserInput</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_UserInput" name="Pengguna Mengisi Data Penanaman">
      <bpmn:incoming>Flow_UserInput</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitForm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SubmitForm" name="Mengirim Data Penanaman">
      <bpmn:incoming>Flow_SubmitForm</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidasiData</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ValidasiData" name="Memvalidasi Data Penanaman">
      <bpmn:incoming>Flow_ValidasiData</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckPlantExists</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckPlantExists" name="Memeriksa Tanaman Terdaftar di Database">
      <bpmn:incoming>Flow_CheckPlantExists</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckLocationExists</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckLocationExists" name="Memeriksa Lokasi Terdaftar di Database">
      <bpmn:incoming>Flow_CheckLocationExists</bpmn:incoming>
      <bpmn:outgoing>Flow_GatewayValidasi</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Validasi" name="Data Valid?">
      <bpmn:incoming>Flow_GatewayValidasi</bpmn:incoming>
      <bpmn:outgoing>Flow_DataValid</bpmn:outgoing>
      <bpmn:outgoing>Flow_DataTidakValid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SimpanDataPenanaman" name="Menyimpan Data Penanaman ke Database">
      <bpmn:incoming>Flow_DataValid</bpmn:incoming>
      <bpmn:outgoing>Flow_InsertPlanting</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_InsertPlanting" name="Menyimpan ke Tabel Plantings">
      <bpmn:incoming>Flow_InsertPlanting</bpmn:incoming>
      <bpmn:outgoing>Flow_QueryPlantForRedirect</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_QueryPlantForRedirect" name="Mengambil Data Tanaman untuk Redirect">
      <bpmn:incoming>Flow_QueryPlantForRedirect</bpmn:incoming>
      <bpmn:outgoing>Flow_ResponseSuccess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ResponseSuccess" name="Menampilkan Pesan Sukses">
      <bpmn:incoming>Flow_ResponseSuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_TrackingPerkembangan</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_TrackingPerkembangan" name="Pengguna Melakukan Tracking Perkembangan">
      <bpmn:incoming>Flow_TrackingPerkembangan</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateTahap</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_UpdateTahapGerminasi" name="Memperbarui Tahap Perkembangan di Database">
      <bpmn:incoming>Flow_UpdateTahap</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateGerminationStage</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateGerminationStage" name="Memperbarui Status Germinasi">
      <bpmn:incoming>Flow_UpdateGerminationStage</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckSiapPanen</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckSiapPanen" name="Memeriksa Apakah Siap Panen">
      <bpmn:incoming>Flow_CheckSiapPanen</bpmn:incoming>
      <bpmn:outgoing>Flow_GatewaySiapPanen</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_SiapPanen" name="Siap Panen?">
      <bpmn:incoming>Flow_GatewaySiapPanen</bpmn:incoming>
      <bpmn:outgoing>Flow_BelumSiap</bpmn:outgoing>
      <bpmn:outgoing>Flow_SiapPanen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PencatatanPanen" name="Pengguna Mencatat Hasil Panen">
      <bpmn:incoming>Flow_SiapPanen</bpmn:incoming>
      <bpmn:outgoing>Flow_SimpanPanen</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SimpanPanen" name="Menyimpan Data Panen ke Database">
      <bpmn:incoming>Flow_SimpanPanen</bpmn:incoming>
      <bpmn:outgoing>Flow_InsertHarvest</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_InsertHarvest" name="Menyimpan ke Tabel Harvests">
      <bpmn:incoming>Flow_InsertHarvest</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdatePlantingStatus</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdatePlantingStatus" name="Memperbarui Status Penanaman Menjadi Selesai">
      <bpmn:incoming>Flow_UpdatePlantingStatus</bpmn:incoming>
      <bpmn:outgoing>Flow_EndPanen</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Panen" name="Proses Panen Selesai">
      <bpmn:incoming>Flow_EndPanen</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_DataTidakValid" name="Data Tidak Valid">
      <bpmn:incoming>Flow_DataTidakValid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_TungguPerkembangan" name="Menunggu Perkembangan Tanaman">
      <bpmn:incoming>Flow_BelumSiap</bpmn:incoming>
      <bpmn:outgoing>Flow_KembaliTracking</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:dataStore id="Database" name="Database" />
    <bpmn:dataStoreReference id="DataStore_Database" name="Database">
      <bpmn:dataStoreRef>Database</bpmn:dataStoreRef>
    </bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="Flow_LoadDataTanaman" sourceRef="StartEvent_Penanaman" targetRef="Task_LoadDataTanaman" />
    <bpmn:sequenceFlow id="Flow_QueryPlants" sourceRef="Task_LoadDataTanaman" targetRef="Task_QueryPlants" />
    <bpmn:sequenceFlow id="Flow_QueryLocations" sourceRef="Task_QueryPlants" targetRef="Task_QueryLocations" />
    <bpmn:sequenceFlow id="Flow_RenderForm" sourceRef="Task_QueryLocations" targetRef="Task_RenderForm" />
    <bpmn:sequenceFlow id="Flow_UserInput" sourceRef="Task_RenderForm" targetRef="Task_UserInput" />
    <bpmn:sequenceFlow id="Flow_SubmitForm" sourceRef="Task_UserInput" targetRef="Task_SubmitForm" />
    <bpmn:sequenceFlow id="Flow_ValidasiData" sourceRef="Task_SubmitForm" targetRef="Task_ValidasiData" />
    <bpmn:sequenceFlow id="Flow_CheckPlantExists" sourceRef="Task_ValidasiData" targetRef="Task_CheckPlantExists" />
    <bpmn:sequenceFlow id="Flow_CheckLocationExists" sourceRef="Task_CheckPlantExists" targetRef="Task_CheckLocationExists" />
    <bpmn:sequenceFlow id="Flow_GatewayValidasi" sourceRef="Task_CheckLocationExists" targetRef="Gateway_Validasi" />
    <bpmn:sequenceFlow id="Flow_DataValid" name="Ya" sourceRef="Gateway_Validasi" targetRef="Task_SimpanDataPenanaman" />
    <bpmn:sequenceFlow id="Flow_DataTidakValid" name="Tidak" sourceRef="Gateway_Validasi" targetRef="EndEvent_DataTidakValid" />
    <bpmn:sequenceFlow id="Flow_InsertPlanting" sourceRef="Task_SimpanDataPenanaman" targetRef="Task_InsertPlanting" />
    <bpmn:sequenceFlow id="Flow_QueryPlantForRedirect" sourceRef="Task_InsertPlanting" targetRef="Task_QueryPlantForRedirect" />
    <bpmn:sequenceFlow id="Flow_ResponseSuccess" sourceRef="Task_QueryPlantForRedirect" targetRef="Task_ResponseSuccess" />
    <bpmn:sequenceFlow id="Flow_TrackingPerkembangan" sourceRef="Task_ResponseSuccess" targetRef="Task_TrackingPerkembangan" />
    <bpmn:sequenceFlow id="Flow_UpdateTahap" sourceRef="Task_TrackingPerkembangan" targetRef="Task_UpdateTahapGerminasi" />
    <bpmn:sequenceFlow id="Flow_UpdateGerminationStage" sourceRef="Task_UpdateTahapGerminasi" targetRef="Task_UpdateGerminationStage" />
    <bpmn:sequenceFlow id="Flow_CheckSiapPanen" sourceRef="Task_UpdateGerminationStage" targetRef="Task_CheckSiapPanen" />
    <bpmn:sequenceFlow id="Flow_GatewaySiapPanen" sourceRef="Task_CheckSiapPanen" targetRef="Gateway_SiapPanen" />
    <bpmn:sequenceFlow id="Flow_BelumSiap" name="Belum" sourceRef="Gateway_SiapPanen" targetRef="Event_TungguPerkembangan" />
    <bpmn:sequenceFlow id="Flow_SiapPanen" name="Ya" sourceRef="Gateway_SiapPanen" targetRef="Task_PencatatanPanen" />
    <bpmn:sequenceFlow id="Flow_SimpanPanen" sourceRef="Task_PencatatanPanen" targetRef="Task_SimpanPanen" />
    <bpmn:sequenceFlow id="Flow_InsertHarvest" sourceRef="Task_SimpanPanen" targetRef="Task_InsertHarvest" />
    <bpmn:sequenceFlow id="Flow_UpdatePlantingStatus" sourceRef="Task_InsertHarvest" targetRef="Task_UpdatePlantingStatus" />
    <bpmn:sequenceFlow id="Flow_EndPanen" sourceRef="Task_UpdatePlantingStatus" targetRef="EndEvent_Panen" />
    <bpmn:sequenceFlow id="Flow_KembaliTracking" sourceRef="Event_TungguPerkembangan" targetRef="Task_TrackingPerkembangan" />
    <bpmn:association id="Association_QueryPlants" sourceRef="Task_QueryPlants" targetRef="DataStore_Database" />
    <bpmn:association id="Association_QueryLocations" sourceRef="Task_QueryLocations" targetRef="DataStore_Database" />
    <bpmn:association id="Association_CheckPlant" sourceRef="Task_CheckPlantExists" targetRef="DataStore_Database" />
    <bpmn:association id="Association_CheckLocation" sourceRef="Task_CheckLocationExists" targetRef="DataStore_Database" />
    <bpmn:association id="Association_InsertPlanting" sourceRef="Task_InsertPlanting" targetRef="DataStore_Database" />
    <bpmn:association id="Association_QueryPlantRedirect" sourceRef="Task_QueryPlantForRedirect" targetRef="DataStore_Database" />
    <bpmn:association id="Association_UpdateGermination" sourceRef="Task_UpdateGerminationStage" targetRef="DataStore_Database" />
    <bpmn:association id="Association_InsertHarvest" sourceRef="Task_InsertHarvest" targetRef="DataStore_Database" />
    <bpmn:association id="Association_UpdatePlantingStatus" sourceRef="Task_UpdatePlantingStatus" targetRef="DataStore_Database" />
  </bpmn:process>
