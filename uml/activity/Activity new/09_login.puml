@startuml
' Referensi: Use Case Overview (00_use_case_overview.puml)
' Use case 09: Login
' Aktor: Admin/Kepala Sek, Petugas BBI, Penangkar/Kepala Satgas, Petugas Gudang
!theme plain
skinparam backgroundColor white
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam swimlane {
    BackgroundColor White
    BorderColor #CCCCCC
    TitleBackgroundColor White
    TitleBorderColor #999999
}

title Activity Diagram - Login

|#White|User|
start
:Masuk ke halaman login;

|#White|Sistem|
:Tampilkan form login;

|#White|User|
:Masukkan email/username;
:Masukkan password;
:Klik tombol login;

|#White|Sistem|
:Validasi input;
if (Input valid?) then (Tidak)
    :Tampilkan pesan error;
    stop
endif

:Query user dari database;
if (User ditemukan?) then (Tidak)
    :Tampilkan pesan error;
    stop
endif

:Verifikasi password;
if (Password benar?) then (Tidak)
    :Tampilkan pesan error;
    stop
endif

:Generate session;
:Set role dan permissions;
:Redirect ke dashboard;

|#White|User|
:Masuk ke dashboard;

stop

@enduml
