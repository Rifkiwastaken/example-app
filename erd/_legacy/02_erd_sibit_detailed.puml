@startuml ERD - SIBESTI Detailed
!theme plain
left to right direction
scale 0.7
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam roundcorner 8
skinparam shadowing false

title SIBESTI - ERD Detail Lengkap
' Sistem Informasi Benih Bersertifikat
' Semua ID menggunakan VARCHAR(36) dengan format {nama_tabel}_id
' Tabel locations telah dihapus (drop_locations_table)
' Tanggal Update: Februari 2026

package "User" {
    entity "users" as users {
        * **user_id** : VARCHAR(36) <<PK>>
        --
        name : VARCHAR(255)
        email : VARCHAR(255) <<UNIQUE>>
        password : VARCHAR(255)
        email_verified_at : TIMESTAMP
        role : ENUM('admin','kepala_satuan_tugas','petugas_sertifikasi','petugas_gudang','petugas_bbi','penangkar')
        location_placement : VARCHAR(255)
        photo_path : VARCHAR(255)
        full_name : VARCHAR(255)
        status : ENUM('active','inactive')
        contact_type : ENUM('pegawai_uptd_bbi_tpph','pegawai_gudang','petugas_sertifikasi','petani','penyuluh','penangkar','lainnya')
        organization : VARCHAR(255)
        position : VARCHAR(255)
        nip : VARCHAR(50)
        primary_phone : VARCHAR(20)
        primary_phone_is_whatsapp : TINYINT(1)
        secondary_phone : VARCHAR(20)
        address : TEXT
        province : VARCHAR(100)
        city : VARCHAR(100)
        district : VARCHAR(100)
        village : VARCHAR(100)
        notes : TEXT
        remember_token : VARCHAR(100)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }
}

package "Planting Module" {
    entity "plant_types" as plant_types {
        * **plant_type_id** : VARCHAR(36) <<PK>>
        --
        name : VARCHAR(255)
        category : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "plants" as plants {
        * **plant_id** : VARCHAR(36) <<PK>>
        --
        name : VARCHAR(255)
        plant_type_id : VARCHAR(36) <<FK>>
        variety : VARCHAR(255)
        status : ENUM('perencanaan','ditanam','dipanen','selesai')
        progress : TINYINT
        planting_location_id : VARCHAR(36) <<FK>>
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "planting_locations" as planting_locations {
        * **planting_location_id** : VARCHAR(36) <<PK>>
        --
        name : VARCHAR(255)
        location_type : ENUM('lapangan','greenhouse','grow_room','padang_rumput','petak_ternak','lainnya')
        planting_format : ENUM('petak','cover_crop','row','lainnya')
        num_beds : INT
        bed_length_m : DECIMAL(8,2)
        bed_width_m : DECIMAL(8,2)
        map_size : VARCHAR(255)
        light_condition : VARCHAR(255)
        description : TEXT
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "plantings" as plantings {
        * **planting_id** : VARCHAR(36) <<PK>>
        --
        plant_id : VARCHAR(36) <<FK>>
        planting_location_id : VARCHAR(36) <<FK>>
        bed_label : VARCHAR(255)
        days_to_emerge : INT
        spacing_between_plants : VARCHAR(255)
        spacing_between_rows : VARCHAR(255)
        sown_at : DATE
        start_method : ENUM
        germination_stage : ENUM
        quantity_planted : INT
        planted_at : DATE
        days_to_harvest : INT
        expected_yield_per_hectare : DECIMAL(12,2)
        perennial : BOOLEAN
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "harvests" as harvests {
        * **harvest_id** : VARCHAR(36) <<PK>>
        --
        plant_id : VARCHAR(36) <<FK>>
        planting_id : VARCHAR(36) <<FK>>
        planting_location_id : VARCHAR(36) <<FK>>
        harvested_at : DATE
        batch_no : VARCHAR(255)
        quantity : DECIMAL(12,2)
        unit : VARCHAR(50)
        quality : VARCHAR(255)
        loss_quantity : DECIMAL(12,2)
        note : TEXT
        source : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "planting_losses" as planting_losses {
        * **planting_loss_id** : VARCHAR(36) <<PK>>
        --
        planting_id : VARCHAR(36) <<FK>>
        loss_date : DATE
        loss_amount : DECIMAL(12,2)
        loss_reason : VARCHAR(255)
        description : TEXT
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "treatments" as treatments {
        * **treatment_id** : VARCHAR(36) <<PK>>
        --
        planting_location_id : VARCHAR(36) <<FK>>
        treatment_type : VARCHAR(255)
        product_detail : VARCHAR(255)
        application_method : VARCHAR(255)
        treatment_date : DATE
        amount_applied : DECIMAL(10,2)
        unit_measurement : VARCHAR(255)
        total_cost : DECIMAL(10,2)
        record_expense : BOOLEAN
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "nutrients" as nutrients {
        * **nutrient_id** : VARCHAR(36) <<PK>>
        --
        planting_location_id : VARCHAR(36) <<FK>>
        product_applied : VARCHAR(255)
        amount_applied : DECIMAL(10,2)
        application_method : VARCHAR(255)
        application_date : DATE
        nitrogen_n : DECIMAL(8,2)
        phosphorus_p : DECIMAL(8,2)
        potassium_k : DECIMAL(8,2)
        description : TEXT
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }
}

package "Certification Module" {
    entity "certifications" as certifications {
        * **certification_id** : VARCHAR(36) <<PK>>
        --
        harvest_id : VARCHAR(36) <<FK>>
        planting_location_id : VARCHAR(36) <<FK>>
        plant_id : VARCHAR(36) <<FK>>
        certification_status : VARCHAR(255)
        seed_class_requested : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "certification_reports" as certification_reports {
        * **certification_report_id** : VARCHAR(36) <<PK>>
        --
        certification_id : VARCHAR(36) <<FK>>
        report_number_bpsb : VARCHAR(255)
        report_date : DATE
        growing_season : VARCHAR(255)
        inspection_phase : VARCHAR(255)
        inspector_name : VARCHAR(255)
        seed_class_result : VARCHAR(255)
        conclusion : ENUM('LULUS','TIDAK LULUS')
        scan_file_path : VARCHAR(255)
        expiry_date : DATE
        certified_seed_quantity : DECIMAL(15,2)
        certified_seed_unit : VARCHAR(50)
        seed_unit : VARCHAR(50)
        seed_unit_quantity : DECIMAL(12,2)
        harvest_per_unit : DECIMAL(12,2)
        harvest_per_unit_unit : VARCHAR(50)
        estimated_sale_price_per_kg : DECIMAL(15,2)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }
}

package "Inventory & Sales" {
    entity "warehouses" as warehouses {
        * **warehouse_id** : VARCHAR(36) <<PK>>
        --
        name : VARCHAR(255)
        internal_id : VARCHAR(50) <<UNIQUE>>
        tracking_type : ENUM('bin_separated','warehouse_only')
        description : TEXT
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "bins" as bins {
        * **bin_id** : VARCHAR(36) <<PK>>
        --
        warehouse_id : VARCHAR(36) <<FK>>
        name : VARCHAR(255)
        internal_id : VARCHAR(50)
        max_capacity : DECIMAL(15,2)
        capacity_unit : VARCHAR(50)
        description : TEXT
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "inventory_types" as inventory_types {
        * **inventory_type_id** : VARCHAR(36) <<PK>>
        --
        category : VARCHAR(255)
        name : VARCHAR(255)
        sku : VARCHAR(100) <<UNIQUE>>
        electronic_id : VARCHAR(255)
        unit : VARCHAR(50)
        estimated_value_per_unit : DECIMAL(15,2)
        estimated_kg_per_unit : DECIMAL(10,2)
        track_individual_lots : BOOLEAN
        low_stock_threshold : DECIMAL(10,2)
        low_stock_unit : VARCHAR(50)
        low_stock_email : VARCHAR(255)
        description : TEXT
        plant_id : VARCHAR(36) <<FK>>
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "inventory_lots" as inventory_lots {
        * **inventory_lot_id** : VARCHAR(36) <<PK>>
        --
        inventory_type_id : VARCHAR(36) <<FK>>
        production_id : VARCHAR(255)
        expiry_date : DATE
        status : ENUM('tersedia','segera_kadaluarsa','kadaluarsa','habis')
        initial_stock : DECIMAL(15,2)
        current_stock : DECIMAL(15,2)
        stock_unit : VARCHAR(50)
        warehouse_id : VARCHAR(36) <<FK>>
        bin_id : VARCHAR(36) <<FK>>
        certification_id : VARCHAR(36) <<FK>>
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "inventory_type_seeds" as inventory_type_seeds {
        * **inventory_type_seed_id** : VARCHAR(36) <<PK>>
        --
        inventory_type_id : VARCHAR(36) <<FK>>
        plant_id : VARCHAR(36) <<FK>>
        planting_location_id : VARCHAR(36) <<FK>>
        certification_report_id : VARCHAR(36) <<FK>>
        quantity : DECIMAL(12,2)
        seed_unit : VARCHAR(50)
        total_seed_quantity : DECIMAL(12,2)
        total_seed_unit : VARCHAR(50)
        estimated_sale_price_per_kg : DECIMAL(12,2)
        expiry_date : DATE
        filled_by_user_id : VARCHAR(36) <<FK>>
        storage_number : VARCHAR(50)
        report_type : VARCHAR(50)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "inventory_transactions" as inventory_transactions {
        * **inventory_transaction_id** : VARCHAR(36) <<PK>>
        --
        inventory_type_id : VARCHAR(36) <<FK>>
        inventory_lot_id : VARCHAR(36) <<FK>>
        transaction_type : ENUM('stok_masuk','stok_keluar','penyesuaian_tambah','penyesuaian_kurang','distribusi','pindah_lokasi')
        quantity : DECIMAL(15,2)
        unit : VARCHAR(50)
        warehouse_id : VARCHAR(36) <<FK>>
        bin_id : VARCHAR(36) <<FK>>
        reason : VARCHAR(255)
        notes : TEXT
        user_id : VARCHAR(36) <<FK>>
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "sales" as sales {
        * **sale_id** : VARCHAR(36) <<PK>>
        --
        receipt_number : VARCHAR(50) <<UNIQUE>>
        sale_date : DATE
        buyer_name : VARCHAR(255)
        buyer_contact : VARCHAR(255)
        total_amount : DECIMAL(15,2)
        payment_method : ENUM('cash','transfer_bank')
        payment_status : ENUM('lunas','belum_lunas')
        notes : TEXT
        user_id : VARCHAR(36) <<FK>>
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "sale_items" as sale_items {
        * **sale_item_id** : VARCHAR(36) <<PK>>
        --
        sale_id : VARCHAR(36) <<FK>>
        inventory_type_id : VARCHAR(36) <<FK>>
        inventory_lot_id : VARCHAR(36) <<FK>>
        quantity : DECIMAL(15,2)
        unit : VARCHAR(50)
        unit_price : DECIMAL(15,2)
        subtotal : DECIMAL(15,2)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "seed_histories" as seed_histories {
        * **seed_history_id** : VARCHAR(36) <<PK>>
        --
        inventory_type_seed_id : VARCHAR(36) <<FK>>
        inventory_type_id : VARCHAR(36)
        action : VARCHAR(50)
        description : TEXT
        old_data : JSON
        new_data : JSON
        user_id : VARCHAR(36) <<FK>>
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }
}

package "Support" {
    entity "plant_notes" as plant_notes {
        * **plant_note_id** : VARCHAR(36) <<PK>>
        --
        plant_id : VARCHAR(36) <<FK>>
        description : TEXT
        note_date : DATE
        keywords : VARCHAR(255)
        attachment_path : VARCHAR(255)
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "plant_photos" as plant_photos {
        * **plant_photo_id** : VARCHAR(36) <<PK>>
        --
        plant_id : VARCHAR(36) <<FK>>
        file_path : VARCHAR(255)
        file_name : VARCHAR(255)
        file_size : BIGINT
        mime_type : VARCHAR(255)
        description : TEXT
        taken_at : DATETIME
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }

    entity "tasks" as tasks {
        * **task_id** : VARCHAR(36) <<PK>>
        --
        title : VARCHAR(255)
        description : TEXT
        priority : ENUM('low','medium','high','highest')
        status : ENUM('pending','in_progress','completed')
        due_date : DATE
        location : VARCHAR(255)
        location_tagged : BOOLEAN
        planting_location_id : VARCHAR(36) <<FK>>
        planting_id : VARCHAR(36) <<FK>>
        created_at : TIMESTAMP
        updated_at : TIMESTAMP
    }
}

' Relationships
users ||--o{ inventory_transactions : "user_id"
users ||--o{ sales : "user_id"
users ||--o{ inventory_type_seeds : "filled_by_user_id"
users ||--o{ seed_histories : "user_id"

plant_types ||--o{ plants : "plant_type_id"

plants ||--o{ plantings : "plant_id"
plants ||--o{ harvests : "plant_id"
plants ||--o{ certifications : "plant_id"
plants ||--o{ plant_notes : "plant_id"
plants ||--o{ plant_photos : "plant_id"
plants }o--|| planting_locations : "planting_location_id"
plants ||--o{ inventory_types : "plant_id"
plants ||--o{ inventory_type_seeds : "plant_id"

planting_locations ||--o{ plantings : "planting_location_id"
planting_locations ||--o{ harvests : "planting_location_id"
planting_locations ||--o{ certifications : "planting_location_id"
planting_locations ||--o{ treatments : "planting_location_id"
planting_locations ||--o{ nutrients : "planting_location_id"
planting_locations ||--o{ tasks : "planting_location_id"
planting_locations ||--o{ inventory_type_seeds : "planting_location_id"

plantings ||--o{ harvests : "planting_id"
plantings ||--o{ planting_losses : "planting_id"
plantings ||--o{ tasks : "planting_id"

harvests ||--o{ certifications : "harvest_id"
certifications ||--o{ certification_reports : "certification_id"
certification_reports ||--o{ inventory_type_seeds : "certification_report_id"

warehouses ||--o{ bins : "warehouse_id"
warehouses ||--o{ inventory_lots : "warehouse_id"
warehouses ||--o{ inventory_transactions : "warehouse_id"

bins ||--o{ inventory_lots : "bin_id"
bins ||--o{ inventory_transactions : "bin_id"

inventory_types ||--o{ inventory_lots : "inventory_type_id"
inventory_types ||--o{ inventory_transactions : "inventory_type_id"
inventory_types ||--o{ inventory_type_seeds : "inventory_type_id"
inventory_types ||--o{ sale_items : "inventory_type_id"

inventory_type_seeds ||--o{ seed_histories : "inventory_type_seed_id"

inventory_lots ||--o{ inventory_transactions : "inventory_lot_id"
inventory_lots ||--o{ sale_items : "inventory_lot_id"
inventory_lots }o--|| certifications : "certification_id"

sales ||--o{ sale_items : "sale_id"

note as N1
SIBESTI - ERD Detail Lengkap
Semua Primary Key menggunakan VARCHAR(36)
Format: {nama_tabel}_id
Tabel locations telah dihapus
Update: Februari 2026
end note

@enduml
